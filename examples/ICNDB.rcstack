        {
          "id": 127,
          "kind": "Button",
          "name": "Submit",
          "rect": {
            "left": 412,
            "top": 38,
            "right": 492,
            "bottom": 60
          },
          "script": "on mouseUp\n  -- GET /jokes/random, or /jokes/random?category=dev\n  put \"/jokes/random\" into path\n  if card field \"Category\" is not empty then\n    put \"?category=\" & urlEncode(card field \"Category\") after path\n  end if\n  put apiGet(path) into joke\n  if joke is empty then -- the Status field says why\n    repeat with i = 1 to 5\n      put empty into card field (item i of \"Joke,ID,Categories,Link,Created\")\n    end repeat\n    exit mouseUp\n  end if\n  -- The reply is one JSON object; read its keys.\n  put key \"value\" of json joke into card field \"Joke\"\n  put key \"id\" of json joke into card field \"ID\"\n  put key \"categories\" of json joke into card field \"Categories\"\n  put key \"url\" of json joke into card field \"Link\"\n  put key \"created_at\" of json joke into card field \"Created\"\nend mouseUp\n",
          "visible": true,
          "style": "RoundRect",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
          "auto_hilite": true,
