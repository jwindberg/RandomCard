          "name": "Test Connection",
          "rect": {
            "left": 352,
            "top": 160,
            "right": 492,
            "bottom": 182
          },
          "script": "on mouseUp\n  -- Any request will do: ask for a random joke.\n  get apiGet(\"/jokes/random\")\n  if it is empty then\n    answer \"No answer from\" && card field \"Base URL\" & \":\" & return & field \"Status\"\n  else\n    answer \"Connected. Chuck Norris approves.\"\n  end if\nend mouseUp\n",
          "visible": true,
          "style": "RoundRect",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
