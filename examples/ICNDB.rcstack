        {
          "id": 124,
          "kind": "Button",
          "name": "Submit",
          "rect": {
            "left": 20,
            "top": 38,
            "right": 100,
            "bottom": 60
          },
          "script": "on mouseUp\n  -- GET /jokes/random, or a joke from any of the checked categories:\n  -- /jokes/random?category=dev&category=food. Several values for one\n  -- name repeat the name, as form encoding does (WHATWG URL Standard).\n  put empty into query\n  repeat with i = 1 to the number of lines of card field \"Choices\"\n    get line i of card field \"Choices\"\n    if char 1 of it is \"✓\" then\n      if query is empty then put \"?\" into query\n      else put \"&\" after query\n      put \"category=\" & urlEncode(word 2 of it) after query\n    end if\n  end repeat\n  showJoke apiGet(\"/jokes/random\" & query)\nend mouseUp\n",
          "visible": true,
          "style": "RoundRect",
          "text_font": "Geneva",
          "text_size": 12,
