        {
          "id": 158,
          "kind": "Button",
          "name": "Submit",
          "rect": {
            "left": 20,
            "top": 38,
            "right": 100,
            "bottom": 60
          },
          "script": "on mouseUp\n  -- GET /jokes/search?query={query}: an object holding the total and\n  -- a result array of jokes.\n  if the length of card field \"Query\" < 3 then\n    answer \"Search for at least three letters.\"\n    exit mouseUp\n  end if\n  put apiGet(\"/jokes/search?query=\" & urlEncode(card field \"Query\")) into found\n  put empty into list\n  repeat with i = 1 to the number of elements of key \"result\" of json found\n    put key \"value\" of element i of key \"result\" of json found into line i of list\n  end repeat\n  put list into card field \"Results\"\n  if found is empty then put empty into card field \"Total\"\n  else put key \"total\" of json found && \"jokes\" into card field \"Total\"\nend mouseUp\n",
          "visible": true,
          "style": "RoundRect",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
