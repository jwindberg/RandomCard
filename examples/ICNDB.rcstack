    {
      "id": 163,
      "name": "Random Joke",
      "script": "on openCard\n  -- The checklist comes from the API itself, the first time.\n  if card field \"Choices\" is empty then loadCategories\nend openCard\n\non loadCategories\n  -- GET /jokes/categories: an array of strings, one a line.\n  put apiGet(\"/jokes/categories\") into cats\n  if cats is not empty then put the elements of json cats into card field \"Choices\"\nend loadCategories\n",
      "background": 110,
      "parts": [
        {
          "id": 122,
          "kind": "Field",
          "name": "Title",
          "rect": {
            "left": 20,
            "top": 8,
