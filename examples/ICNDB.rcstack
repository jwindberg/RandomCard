            "right": 492,
            "bottom": 180
          },
          "script": "on mouseUp\n  -- Open the clicked joke on the Joke by ID card, by its id.\n  put word 2 of the clickLine into n\n  if n is empty then exit mouseUp\n  get key \"id\" of element n of key \"result\" of json field \"Response\"\n  if it is empty then exit mouseUp\n  put it into card field \"Joke ID\" of card \"Joke by ID\"\n  go to card \"Joke by ID\"\n  send \"mouseUp\" to card button \"Submit\"\nend mouseUp\n",
          "visible": true,
          "style": "Scrolling",
          "text_font": "Geneva",
