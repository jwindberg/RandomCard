  "cards": [
    {
      "id": 6496,
      "name": "title",
      "script": "on openCard\nsetVisibleOfLevelSelectionStuff false\nupdatePlayLevelButton\n\nplayTitleMusic\n\npass openCard\nend openCard\n\non updatePlayLevelButton\nif getSpeedrunModeEnabled() then\nset enabled of button id 3 to true\nset name of button id 3 to \"Time Trial...\"\nelse\nset enabled of button id 3 to (maxLevelPlayed() > 1)\nset name of button id 3 to \"Start At...\"\nend if\nend updatePlayLevelButton\n\non setVisibleOfLevelSelectionStuff isVisible\nlock screen\nsetVisibleOfLevelSelectionStuffWithoutLockingScreen isVisible\nunlock screen\nend setVisibleOfLevelSelectionStuff\n\non setVisibleOfLevelSelectionStuffWithoutLockingScreen isVisible\nput empty into button \"levelSelection\"\nset visible of button \"levelSelection\" to false\nset height of button \"levelSelection\" to textHeight of card field \"levels\"\nset enabled of button \"Go!\" to false\n\nset rect of card field \"darken\" to -4,-1,513,343\nset visible of card field \"levels\" to isVisible\nset visible of card field \"darken\" to isVisible\nset visible of card field \"speedrunMode\" to ¬\nisVisible and getSpeedrunModeEnabled()\nset visible of button \"boxOverlay1\" to isVisible\nset visible of button \"boxOverlay2\" to isVisible\nset visible of button \"boxOverlay3\" to isVisible\nset visible of button \"Cancel\" to isVisible\nset visible of button \"Go!\" to isVisible\nset visible of button \"levelSelectionButton\" to isVisible\nend setVisibleOfLevelSelectionStuffWithoutLockingScreen\n\non startAtLevel levelNumber, timeTrialMode\nlock screen\nstartAtLevelWithAlreadyLockedScreen levelNumber, timeTrialMode\nend startAtLevel\n\non startAtLevelWithAlreadyLockedScreen levelNumber, inTimeTrialMode\nglobal timeTrialMode\nput inTimeTrialMode into timeTrialMode\nset cursor to none\ngo to card \"game\"\nshow button \"blackOverlay\"\nunlock screen with visual effect iris close fast\n\nput (line levelNumber of card field \"_levelOrder\" of card \"levels\") ¬\n& return & levelNumber into card field \"currentLevel\" of card \"game\"\n\nif isMusicEnabled() then\nfadeOutMusicInTicks 30\nelse\nwait 15\nend if\n\nsend \"startGame\" to button \"play\"\nend startAtLevelWithAlreadyLockedScreen",
      "background": 6299,
