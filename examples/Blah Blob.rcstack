    {
      "id": 4864,
      "name": "levels",
      "script": "on setTile tile, tilePos, offsetX, offsetY\nput item 1 of tilePos + offsetX into x\nput item 2 of tilePos + offsetY into y\n\nif y ≤ 0 or y > the number of lines of card field currentLevel() then\nexit setTile\nend if\n\nif x ≤ 0 or x > 26 then\nexit setTile\nend if\n\nput tilePosToCharAndLine(x, y) into charAndLine\n\nif charAndLine is empty then\nbeep\nexit setTile\nend if\n\nput item 1 of charAndLine into charIndex\nput item 2 of charAndLine into lineIndex\nsetTileAtCharAndLine tile, charIndex, lineIndex\nend setTile\n\non setTileAtCharAndLine tile, charIndex, lineIndex\nif tile is in \"123456789\" then\nif char charIndex-1 of line lineIndex of card field currentLevel() ¬\nis in \"123456789\" then\nput tile into char charIndex-1 of line lineIndex of card field currentLevel()\nelse\nput tile before char charIndex of line lineIndex of card field currentLevel()\nend if\nelse\nput tile into char charIndex of line lineIndex of card field currentLevel()\n\nif char charIndex-1 of line lineIndex of card field currentLevel() ¬\nis in \"123456789\" then\ndelete char charIndex-1 of line lineIndex of card field currentLevel()\nend if\nend if\nend setTileAtCharAndLine\n\non dropper\nput tilePosAtGlobalPos(the mouseH, the mouseV) into tilePos\nput tilePosToCharAndLine(item 1 of tilePos, item 2 of tilePos) into charAndLine\nput char (item 1 of charAndLine) of line (item 2 of charAndLine) ¬\nof card field currentLevel() into newTile\n\nhide card field \"_tiles1\"\nhide card field \"_tiles2\"\nhide card field \"_tiles3\"\n\nrepeat with i = 1 to 3\nput \"_tiles\" & i into tileFieldName\n\nif newTile = quote then\nsend \"setCurrentTile quote\" to card field tileFieldName\nelse\nsend \"setCurrentTile \" & quote & newTile & quote to card field tileFieldName\nend if\n\nif the result is true then exit repeat\nend repeat\n\nshow card field tileFieldName\nend dropper\n\non performSet\nglobal currentEditorTile\n\nif the optionKey is down then\ndropper\nexit performSet\nend if\n\nif currentEditorTile is empty then exit performSet\nput tilePosAtGlobalPos(the mouseH, the mouseV) into tilePos\n\nif currentEditorTile = \"¡\" then\nsetTile \"¡\", tilePos, 0, 0\nsetTile \"™\", tilePos, 1, 0\nsetTile \"œ\", tilePos, 0, 1\nsetTile \"∑\", tilePos, 1, 1\nexit performSet\nend if\n\nif currentEditorTile = \"|\" then\nsetTile \"u\", tilePos, 0, 0\nsetTile \"i\", tilePos, 1, 0\nsetTile \"o\", tilePos, 2, 0\nsetTile \"j\", tilePos, 0, 1\nsetTile \"k\", tilePos, 1, 1\nsetTile \"l\", tilePos, 2, 1\nsetTile \"n\", tilePos, 0, 2\nsetTile \"m\", tilePos, 1, 2\nsetTile \".\", tilePos, 2, 2\nexit performSet\nend if\n\nif currentEditorTile = \"=\" then\nsetTile \"=\", tilePos, 0, 0\nsetTile \"]\", tilePos, 0, 1\nexit performSet\nend if\n\nif currentEditorTile = \"+\" then\nsetTile \"+\", tilePos, 0, 0\nsetTile \"}\", tilePos, 0, 1\nexit performSet\nend if\n\nsetTile currentEditorTile, tilePos, 0, 0\nend performSet\n\non startRect\nglobal currentEditorTile, rectToolStartPos\nput empty into rectToolStartPos\n\nif the optionKey is down then\ndropper\nexit startRect\nend if\n\nif currentEditorTile is empty then exit startRect\nif currentEditorTile is in \"|¡\" then exit startRect\n\nput tilePosAtGlobalPos(the mouseH, the mouseV) into tilePos\nput tilePos into rectToolStartPos\nsetTile currentEditorTile, tilePos, 0, 0\nend startRect\n\non midRect\nglobal rectToolStartPos, lastFlashTime\n\nif rectToolStartPos = empty then\nexit midRect\nend if\n\nput the ticks into curTime\n\nif lastFlashTime is empty or curTime - lastFlashTime > 3 then\nset hilite of button \"rect\" to not hilite of button \"rect\"\nput curTime into lastFlashTime\nend if\nend midRect\n\non endRect\nglobal currentEditorTile, rectToolStartPos\nif currentEditorTile is empty or rectToolStartPos is empty then\nexit endRect\nend if\nif currentEditorTile is in \"|¡\" then exit endRect\nset hilite of button \"rect\" to true\nput currentEditorTile into tile\n\nput tilePosAtGlobalPos(the mouseH, the mouseV) into tilePos\n\nput min(item 1 of tilePos, item 1 of rectToolStartPos) into x1\nput min(item 2 of tilePos, item 2 of rectToolStartPos) into y1\nput max(item 1 of tilePos, item 1 of rectToolStartPos) into x2\nput max(item 2 of tilePos, item 2 of rectToolStartPos) into y2\n\nrepeat with y = y1 to y2\nput tilePosToCharAndLine(x1, y) into charAndLine\n\nif charAndLine is empty then\nbeep\nexit endRect\nend if\n\nput item 1 of charAndLine into charIndex\n\nrepeat with x = x1 to x2\nif tile is in \"123456789\" then\nif char charIndex-1 of line y of card field currentLevel() ¬\nis in \"123456789\" then\nput tile into char charIndex-1 of line y of card field currentLevel()\nadd 1 to charIndex\nelse\nput tile before char charIndex of line y of card field currentLevel()\nadd 2 to charIndex\nend if\nelse\nput tile into char charIndex of line y of card field currentLevel()\n\nif char charIndex-1 of line y of card field currentLevel() ¬\nis in \"123456789\" then\ndelete char charIndex-1 of line y of card field currentLevel()\nelse\nadd 1 to charIndex\nend if\nend if\n\nif char charIndex of line y of card field currentLevel() ¬\nis in \"123456789\" then\nadd 1 to charIndex\nend if\nend repeat\nend repeat\nend endRect\n\nfunction currentTool\nglobal lastCurrentTool\n\nif lastCurrentTool is empty then\nif hilite of button \"set\" is true then\nput \"set\" into lastCurrentTool\nelse if hilite of button \"rect\" is true then\nput \"rect\" into lastCurrentTool\nelse\nput \"type\" into lastCurrentTool\nend if\nend if\n\nreturn lastCurrentTool\nend currentTool\n\nfunction currentLevel\nglobal lastCurrentLevel\n\nif lastCurrentLevel is empty then\nrepeat with i = 1 to the number of card fields\nif \"_\" is in short name of card field i then\nnext repeat\nend if\n\nif visible of card field i then\nput short name of card field i into lastCurrentLevel\nexit repeat\nend if\nend repeat\nend if\n\nreturn lastCurrentLevel\nend currentLevel\n\non updateTool\nglobal lastCurrentTool\nput empty into lastCurrentTool\n\nif currentTool() = \"type\" then\nset lockText of card field currentLevel() to false\nelse\nset lockText of card field currentLevel() to true\nend if\nend updateTool\n\nfunction isToolInUse\nif \"card field\" is not in the target then\nreturn false\nend if\n\nput currentTool() into theTool\n\nif theTool = \"type\" then\nreturn false\nend if\n\nput currentLevel() into levelName\n\nif the short name of the target ≠ levelName then\nreturn false\nend if\n\nreturn true\nend isToolInUse\n\non mouseDown\nglobal lastToolLoc\nif not isToolInUse() then pass mouseDown\nput the mouseLoc into lastToolLoc\nput empty into bg field (currentLevel() & \"_map\")\n\n--answer tilePosAtGlobalPos(the mouseH, the mouseV)\n--exit mouseDown\n\nif currentTool() = \"set\" then\nperformSet\nelse if currentTool() = \"rect\" then\nstartRect\nend if\n\nend mouseDown\n\non mouseUp\nglobal lastToolLoc\nif not isToolInUse() then pass mouseUp\nput the mouseLoc into lastToolLoc\n\nif currentTool() = \"rect\" then\nendRect\nend if\n\nend mouseUp\n\non mouseStillDown\nglobal lastToolLoc\nif not isToolInUse() then pass mouseStillDown\n\nif currentTool() = \"rect\" then\nmidRect\nexit mouseStillDown\nend if\n\nput the mouseLoc into newLoc\n\nif newLoc = lastToolLoc then\npass mouseStillDown\nend if\n\nput newLoc into lastToolLoc\n\nif currentTool() = \"set\" then\nperformSet\nend if\nend mouseStillDown\n\nfunction tilePosAtGlobalPos x, y\nput (y - 1 - top of card field currentLevel() + ¬\nscroll of card field currentLevel()) div 16 + 1 into yi\nput (x - 4 - left of card field currentLevel()) div 16 + 1 into xi\nreturn xi & \",\" & yi\nend tilePosAtGlobalPos\n\nfunction tilePosToCharAndLine xi, yi\nput line yi of card field currentLevel() into theLine\nput the number of chars of theLine into charCount\nput 1 into charIndex\n\nrepeat while charIndex ≤ charCount\nif char charIndex of theLine is in \"123456789\" then\nadd 1 to charIndex\nend if\n\nsubtract 1 from xi\n\nif xi = 0 then\nreturn charIndex & \",\" & yi\nend if\n\nadd 1 to charIndex\nend repeat\n\nreturn empty\nend tilePosToCharAndLine\n\non createLevel levelName\ndoMenu \"new field\"\nset name of last card field to levelName\nset rect of card field levelName to \"0,0,438,342\"\nset textFont of card field levelName to \"Sprites\"\nset textSize of card field levelName to 16\nset style of card field levelName to \"scrolling\"\nset dontWrap of card field levelName to true\n\ncreateLevelNameField levelName\n\nput \"s                        s\" into newLine\n\nput newLine into card field levelName\nrepeat 99 times\nput return & newLine after card field levelName\nend repeat\nchoose browse tool\n\nensureLevelObjectsCreated true, false\n\npickLevel levelName\nend createLevel\n\non pickLevel levelName\nglobal lastCurrentLevel\n\nhide card field \"_levelOrder\"\nhide card field \"_otherLevels\"\nhide button \"New level!\"\n\nrepeat with i = 1 to the number of card fields\nput the short name of card field i into fieldName\nif \"_\" is not in fieldName then\nhide card field fieldName\nhide card field (fieldName & \"_name\")\nend if\nend repeat\n\nshow card field levelName\nshow card field (levelName & \"_name\")\nput levelNumberOfLevelName(levelName) into levelNumber\nput levelName & return & levelNumber into card field \"currentLevel\" of card \"game\"\nput levelName into lastCurrentLevel\nset textSize of card field \"_tiles1\" to textSize of card field levelName\nset textSize of card field \"_tiles2\" to textSize of card field levelName\nset textSize of card field \"_tiles3\" to textSize of card field levelName\nupdateTool\nend pickLevel\n\non createLevelNameField levelName\nput (levelName & \"_name\") into levelNameName\ndoMenu \"new field\"\nset name of last card field to levelNameName\nset rect of card field levelNameName to \"438,280,512,304\"\nset textFont of card field levelNameName to \"Helvetica\"\nset textSize of card field levelNameName to 9\nset style of card field levelNameName to \"rectangle\"\nend createLevelNameField",
