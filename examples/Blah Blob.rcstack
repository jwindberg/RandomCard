        {
          "id": 43,
          "kind": "Field",
          "name": "currentLevel",
          "rect": {
            "left": 421,
            "top": 144,
            "right": 498,
            "bottom": 172
          },
          "script": "",
          "visible": false,
          "style": "Rectangle",
