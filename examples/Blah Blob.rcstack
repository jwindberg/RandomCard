    {
      "id": 5705,
      "name": "instructions",
      "script": "on updateControls\nupdateControlTextInField \"controls1\", 1, ¬\ndisplayNameForControl(\"control_left\", 1)\nupdateControlTextInField \"controls1\", 2, ¬\ndisplayNameForControl(\"control_right\", 2)\nupdateControlTextInField \"controls2\", 1, ¬\ndisplayNameForControl(\"control_bounce\", 3)\nupdateControlTextInField \"controls3\", 1, ¬\ndisplayNameForControl(\"control_bounce\", 4)\nend updateControls\n\non updateControlTextInField fieldName, index, text\nrepeat with i = 1 to the number of words of card field fieldName of card \"instructions\"\nput word i of card field fieldName of card \"instructions\" into theWord\n\nif char 1 of theWord = \"[\" then\nsubtract 1 from index\nif index ≠ 0 then next repeat\n\nput empty into endBracket\nrepeat with j = 1 to the number of chars of theWord\nif char j of theWord = \"]\" then\nput j-1 into endBracket\nexit repeat\nend if\nend repeat\n\nif endBracket is empty then exit updateControlTextInField\n\nput text into char 2 to endBracket of word i of card field fieldName of card \"instructions\"\nexit updateControlTextInField\nend if\nend repeat\nend updateControlTextInField\n\nfunction displayNameForControl controlName, order\nput getCurrentControls() into controls\n\nrepeat with i = 1 to the number of lines of controls\nif item 1 of line i of controls = controlName then\nput item 2 of line i of controls into displayName\n\nif displayName = \"(Unset)\" then\nif order = 1 then\nreturn \"Nothing??\"\nelse if order = 2 then\nreturn \"Nothing?!?\"\nelse\nreturn \"Nothing?!?!\"\nend if\nelse\nreturn displayName\nend if\nend if\nend repeat\n\nreturn \"Error!\"\nend displayNameForControl\n\non goBackToTitle\nvisual effect push left\ngo to card \"title\"\nend goBackToTitle",
      "background": 4779,
      "parts": [
        {
          "id": 1,
          "kind": "Button",
          "name": "Back To Title Background",
          "rect": {
            "left": 416,
            "top": 273,
            "right": 492,
            "bottom": 324
          },
          "script": "on mouseDown\nhandleCompositeButtonMouseDown ¬\n\"Back To Title Background,Back To Title,Back To Title Arrow\",¬\n\"goBackToTitle\", \"this card\"\nend mouseDown\n",
          "visible": true,
          "style": "Standard",
          "text_font": "Chicago",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
