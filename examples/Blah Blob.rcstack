            "bottom": 329
          },
          "script": "on mouseUp\nif visible of card field \"_levelOrder\" then\nshow card field currentLevel()\nhide card field \"_levelOrder\"\nhide card field \"_otherLevels\"\nelse\nhide card field currentLevel()\nshow card field \"_otherLevels\"\nshow card field \"_levelOrder\"\nset lockText of card field \"_levelOrder\" to false\nset lockText of card field \"_otherLevels\" to false\nend if\nend mouseUp",
