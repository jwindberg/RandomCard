          "kind": "Button",
          "name": "show stuff",
          "rect": {
            "left": 438,
            "top": 0,
            "right": 474,
            "bottom": 12
          },
          "script": "on mouseUp\nif not inBackground() then exit mouseUp\n\nask \"level name?\"\nif the result is cancel then exit mouseUp\n\nput it into levelName\n\nshow bg field (levelName & \"_map\")\nrepeat with i = 1 to 9\nshow bg button (levelName & \"_c\" & i)\nend repeat\nend mouseUp",
