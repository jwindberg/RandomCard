    },
    {
      "id": 11713,
      "name": "high scores",
      "script": "on openCard\nset visible of button \"deathsOrder\" to ¬\n(not (card field \"deathsAsc_data\" of card \"data\" is empty and ¬\ncard field \"deathsExtra_data\" of card \"data\" is empty))\n\nplayTitleMusic\npass openCard\nend openCard\n\non hiliteHighScore listType, rank\npopulateDeathsOrderButton\n\nput ((rank-1) div 10) * 10 + 1 into start\nput (rank-1) mod 10 + 1 into theLine\nshowHighscoreList listType, start\n\nput getDisplayTypeForListType(listType) into displayType\nset textStyle of line theLine of card field (displayType & \"_names\") to ¬\n\"bold,shadow,condense\"\n\nif listType = \"deathsAsc\" then\nset hilite of button \"deaths\" to true\nselectDeathsOrder \"deathsAsc\"\nelse if listType = \"deathsDec\" then\nset hilite of button \"deaths\" to true\nselectDeathsOrder \"deathsDec\"\nelse if listType = \"deathsExtra\" then\nset hilite of button \"deaths\" to true\nselectDeathsOrder \"deathsExtra\"\nelse if listType = \"speedruns\" then\nset hilite of button \"speedruns\" to true\nelse\nset hilite of button \"time trials:\" to true\npopulateSelectedLevelButton false\nput char 6 to (the number of chars of listType) of listType into levelNum\nselect line levelNum of button \"selectedLevel\"\nend if\nend hiliteHighScore\n\non populateDeathsOrderButton\nput \"Descending\" into list\n\nif card field \"deathsAsc_data\" of card \"data\" is not empty then\nput return & \"Ascending (Full Game)\" after list\nend if\n\nif card field \"deathsExtra_data\" of card \"data\" is not empty then\nput return & \"Extra Level\" after list\nend if\n\nput list into button \"deathsOrder\"\nend populateDeathsOrderButton\n\non selectDeathsOrder listType\nif listType = \"deathsAsc\" then\nput \"Ascending (Full Game)\" into targetText\nelse if listType = \"deathsExtra\" then\nput \"Extra Level\" into targetText\nelse\nput \"Descending\" into targetText\nend if\n\nrepeat with i = 1 to the number of lines of button \"deathsOrder\"\nif line i of button \"deathsOrder\" = targetText then\nselect line i of button \"deathsOrder\"\nexit selectDeathsOrder\nend if\nend repeat\n\nselect line 1 of button \"deathsOrder\"\nend selectDeathsOrder\n\non populateSelectedLevelButton includeNames\nput maxLevelPlayed() into maxLevel\nput empty into button \"selectedLevel\"\n\nrepeat with i = 1 to maxLevel\nif i = 21 then\nput \"Extra Level\" into line i of button \"selectedLevel\"\nelse if includeNames = true then\nput \"Level\" && i & \" - \" & ¬\nshortLevelDisplayNameForLevelName(levelNameForLevelNumber(i)) ¬\ninto line i of button \"selectedLevel\"\nelse\nput \"Level\" && i into line i of button \"selectedLevel\"\nend if\nend repeat\nend populateSelectedLevelButton\n\nfunction getCurrentListType\nput the selectedButton of family 1 into theButton\ndo \"put \" & theButton & \" into buttonIdentifier\"\nif buttonIdentifier = \"deaths\" then\nif visible of button \"deathsOrder\" then\nput the selectedText of button \"deathsOrder\" into choice\nif choice = \"Ascending (Full Game)\" then\nreturn \"deathsAsc\"\nelse if choice = \"Extra Level\" then\nreturn \"deathsExtra\"\nelse\nreturn \"deathsDec\"\nend if\nelse\nreturn \"deathsDec\"\nend if\nelse if buttonIdentifier = \"speedruns\" then\nreturn \"speedruns\"\nelse\nput word 2 of the selectedLine of button \"selectedLevel\" into lineNum\nreturn \"level\" & lineNum\nend if\nend getCurrentListType\n\nfunction getDisplayTypeForListType listType\nif listType = \"deathsAsc\" or listType = \"deathsDec\" or listType = \"deathsExtra\" then\nreturn \"deaths\"\nelse\nreturn \"speedrun\"\nend if\nend getDisplayTypeForListType\n\nfunction getCurrentListStart\nreturn line 1 of card field \"numbers\"\nend getCurrentListStart\n\non showHighscoreList listType, start\nput getDisplayTypeForListType(listType) into displayType\n\nif listType = \"deathsAsc\" then\nput true into button \"discoveredDeathsAsc\"\nend if\n\nlock screen\nrepeat with i = 1 to the number of card fields\nput short name of card field i into theName\nput offset(\"_\", theName) into separator\nif separator = 0 then next repeat\n\nput char 1 to separator-1 of theName into baseName\nset visible of card field i to (baseName = displayType)\nend repeat\n\nupdateLists listType, start\nunlock screen\nend showHighscoreList\n\non updateLists listType, start\nput ranksInList(listType) into totalCount\n\nput min(start, totalCount) into startLine\nput min(start+9, totalCount) into endLine\n\nset enabled of button \"back\" to (startLine > 1)\nset enabled of button \"forward\" to (endLine < totalCount)\n\nput empty into card field \"numbers\"\n\nrepeat with i = start to start+9\nput i into line (i - start + 1) of card field \"numbers\"\nend repeat\n\nif listType = \"deathsAsc\" or listType = \"deathsDec\" or listType = \"deathsExtra\" then\nupdateDeaths listType, startLine, endLine\nelse\nupdateSpeedrun listType, startLine, endLine\nend if\nend updateLists\n\non updateDeaths listType, startLine, endLine\nput empty into card field \"deaths_names\"\nput empty into card field \"deaths_deaths\"\nput empty into card field \"deaths_wins\"\nput empty into card field \"deaths_startedAt\"\nput empty into card field \"deaths_stoppedAt\"\n\nif startLine < 1 then exit updateDeaths\n\nrepeat with i = startLine to endLine\nput i - startLine + 1 into theLine\nput nameForRank(listType, i) into theName\nput elideName(\"deaths\", theName) into line theLine of card field \"deaths_names\"\nput deathsForRank(listType, i) into deathCount\n\nif deathCount = 0 and (listType = \"deathsAsc\" or listType = \"deathsExtra\") then\nput \"‚ \" & deathCount into line theLine of card field \"deaths_deaths\"\nset textFont of char 1 of line theLine of card field \"deaths_deaths\" ¬\nto \"Sprites\"\nset textSize of char 1 of line theLine of card field \"deaths_deaths\" ¬\nto 16\nelse\nput deathCount into line theLine of card field \"deaths_deaths\"\nend if\n\nput winsForRank(listType, i) into line theLine of card field \"deaths_wins\"\n\nif listType = \"deathsExtra\" then\nput \"Extra\" into startLevelText\nput \"Extra\" into endLevelText\nelse\nput \"Level\" && startLevelForRank(listType, i) into startLevelText\nput endLevelForRank(listType, i) into endLevel\nif endLevel ≥ 20 then\nput \"The end!\" into endLevelText\nelse\nput \"Level\" && endLevel into endLevelText\nend if\nend if\n\nput startLevelText into line theLine of card field \"deaths_startedAt\"\nput endLevelText into line theLine of card field \"deaths_stoppedAt\"\nend repeat\nend updateDeaths\n\non updateSpeedrun listType, startLine, endLine\nput empty into card field \"speedrun_names\"\nput empty into card field \"speedrun_times\"\nput empty into card field \"speedrun_deaths\"\nput empty into card field \"speedrun_wins\"\n\nif startLine < 1 then exit updateSpeedrun\n\nrepeat with i = startLine to endLine\nput i - startLine + 1 into theLine\nput nameForRank(listType, i) into theName\nput elideName(\"speedrun\", theName) into line theLine of card field \"speedrun_names\"\nput deathsForRank(listType, i) into line theLine of card field \"speedrun_deaths\"\nput winsForRank(listType, i) into line theLine of card field \"speedrun_wins\"\nput gameCyclesToTime(timeForRank(listType, i)) ¬\ninto line theLine of card field \"speedrun_times\"\nend repeat\nend updateSpeedRun\n\nfunction elideName type, text\nput textFont of card field (type & \"_names\") into theFont\nput textSize of card field (type & \"_names\") into theSize\nput textStyle of card field (type & \"_names\") into theStyle\nput width of card field (type & \"_names\") - 5 into targetWidth\n\nrepeat while textWidth(text, theFont, theSize, theStyle) > targetWidth\nput char 1 to (the number of chars of text - 2) of text & \"…\" into text\nend repeat\n\nreturn text\nend elideName\n\non goBackToTitle\nvisual effect push up\ngo to card \"title\"\nend goBackToTitle\n",
      "background": 4779,
