          "visible": true,
          "style": "Transparent",
          "text_font": "Palatino",
          "text_size": 10,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "Hey Alex Metcalf and Kevin Harris!\nI owe you both 15 USD for your shareware software. If you're still out there, I hope we can get in touch so I can send it along, even if it's thirty years late. (Better late than never, right?)\n",
          "hilite": false,
          "auto_hilite": false,
          "show_name": false,
