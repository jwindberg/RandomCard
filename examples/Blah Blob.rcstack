          },
          "script": "on mouseDown\nglobal selectedLevelNeedsToReset\nput true into selectedLevelNeedsToReset\npopulateSelectedLevelButton true\nend mouseDown\n\non mouseUp\nglobal selectedLevelNeedsToReset\nput false into selectedLevelNeedsToReset\nresetSelectedLine\npopulateSelectedLevelButton false\nset hilite of button \"Time Trials:\" to true\nshowHighscoreList getCurrentListType(), 1\nend mouseUp\n\non mouseLeave\nglobal selectedLevelNeedsToReset\nif selectedLevelNeedsToReset = true then\nresetSelectedLine\nend if\nend mouseLeave\n\non resetSelectedLine\nput word 2 of the selectedLine of me into levelNum\nif levelNum = 21 then\nput \"Extra Level\" into line levelNum of me\nelse\nput \"Level\" && levelNum into line levelNum of me\nend if\nend resetSelectedLine",
