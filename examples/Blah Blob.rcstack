          "text_size": 9,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "boing\n1",
          "hilite": false,
          "auto_hilite": false,
          "show_name": false,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
