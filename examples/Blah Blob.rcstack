            "top": 198,
            "right": 367,
            "bottom": 218
          },
          "script": "on mouseUp\nglobal speedrunMode, paused\nanswer \"Are you sure you want to end your game?\" with \"Yes\" or \"Oops, No\"\nif it is not \"Yes\" then exit mouseUp\n\nput false into paused\n\nif speedrunMode then\ngoBackToTitle\nexit mouseUp\nend if\n\nlock screen\nsend \"maybeShowAppropriateEndGameDialog\" to button \"dialogs\"\nput the result into actuallyShown\n\nif actuallyShown then\nsend \"hidePauseDialogContents\" to button \"dialogs\"\nend if\nunlock screen\n\nif actuallyShown = false then\ngoBackToTitle\nend if\nend mouseUp",
          "visible": true,
          "style": "Standard",
