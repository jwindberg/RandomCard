    {
      "id": 4158,
      "name": "",
      "script": "",
      "background": 4779,
      "parts": [
        {
          "id": 1,
          "kind": "Button",
          "name": "Generate gradient!",
          "rect": {
            "left": 0,
            "top": 326,
            "right": 124,
            "bottom": 342
          },
          "script": "on mouseUp\nput \"0,18,2,16,9,27,11,25,1,19,3,17,8,26,10,24,4,22,6,20,13,31,15,29,5,23,7,21,12,30,14,28\" into pattern\nput empty into pattern2\n\nrepeat with i = 0 to 31\nput (item i+1 of pattern) into orgPixelNum\n\nput orgPixelNum*2 into pixelNum\n\nif (orgPixelNum div 4) mod 2 = 1 then\nadd 1 to pixelNum\nend if\n\nput i into item pixelNum+1 of pattern2\nend repeat\n\nrepeat with i = 0 to 31\nput (item i+1 of pattern) into orgPixelNum\n\nput orgPixelNum*2 into pixelNum\n\nif (orgPixelNum div 4) mod 2 = 0 then\nadd 1 to pixelNum\nend if\n\nput i+32 into item pixelNum+1 of pattern2\nend repeat\n\nchoose select tool\ndrag from 0,0 to 511,341\ndoMenu \"clear picture\"\n\nchoose pencil tool\n\nput 511 into theWidth\nput 192 into theHeight\n\nput 0 into startLightnessX\nput -12 into endLightnessX\n\nput 28 into startLightnessY\nput 64 into endLightnessY\n\nrepeat with y = 0 to theHeight\nput y / theHeight into uy\nput 1-(1-uy)*(1-uy) into uuy\nput round(uuy*(endLightnessY-startLightnessY)) + startLightnessY into lightnessY\n\nput y mod 8 into yy\n\nrepeat with x = 0 to theWidth\nput x / theWidth into ux\nmultiply ux by (1.0-uy)\nput round(ux*(endLightnessX-startLightnessX)) + startLightnessX into lightnessX\n\nput x mod 8 into xx\nput yy*8 + xx into i\n\nif item i+1 of pattern2 ≥ lightnessX+lightnessY then\nclick at x, y\nend if\nend repeat\nend repeat\n\n-- choose select tool\n-- drag from 0,0 to 7,341\n-- doMenu \"copy picture\"\n\n-- repeat with x = 1 to 63\n-- doMenu \"paste picture\"\n-- drag from 0,0 to x*8,0\n-- end repeat\n\nchoose browse tool\nend mouseUp",
          "visible": true,
          "style": "Transparent",
          "text_font": "Geneva",
          "text_size": 9,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": false,
          "dont_wrap": false,
