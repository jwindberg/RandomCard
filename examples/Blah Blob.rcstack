          },
          "script": "-- on mouseUp\n-- put 256 into w\n-- put 128 into h\n-- put w + 8 into ww\n-- put h + 8 into hh\n-- set rect of button \"pauseoverlay1\" to ¬\n-- (512-ww)/2,(342-hh)/2,(512-ww)/2 + ww + 1,(342-hh)/2 + hh + 1\n\n-- set rect of button \"pauseoverlay2\" to left of button \"pauseoverlay1\"+1,¬\n-- top of button \"pauseoverlay1\"+1,right of button \"pauseoverlay1\"-2,¬\n-- bottom of button \"pauseoverlay1\"-2\n\n-- set rect of card field \"pauseText\" to ¬\n-- (512-w)/2,(342-h)/2,(512-w)/2 + w,(342-h)/2 + h\n\n-- set left of button \"Resume\" to left of card field \"pauseText\" + 17\n-- set bottom of button \"Resume\" to bottom of card field \"pauseText\" - 17\n-- set right of button \"End game\" to right of card field \"pauseText\" - 17\n-- set bottom of button \"End game\" to bottom of card field \"pauseText\" - 17\n-- set rect of card field \"pauseDarken\" to -3,-1,513,343\n-- end mouseUp",
          "visible": true,
          "style": "Rectangle",
          "text_font": "Palatino",
          "text_size": 36,
          "text_style": "bold,italic",
          "text_align": "Center",
