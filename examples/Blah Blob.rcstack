          },
          "script": "on showPauseDialog\nglobal scrollY, paused, pauseStartTime\nlock screen\nput scrollY mod 2 into offset\nshowDarken offset\nshowDialogBox 256, 128, false\nshow card field \"pauseText\"\nshow button \"Resume\"\nshow button \"End Game\"\nunlock screen\nput true into paused\nput the ticks into pauseStartTime\nend showPauseDialog\n\non hidePauseDialog\nhide card field \"darken\" of card \"game\"\nhideDialogBox\nhidePauseDialogContents\nend hidePauseDialog\n\non hidePauseDialogContents\nhide card field \"pauseText\" of card \"game\"\nhide button \"Resume\" of card \"game\"\nhide button \"End Game\" of card \"game\"\nend hidePauseDialogContents\n\non showSillyWinDialog\nglobal pauseStartTime, winCount, playingMovingPlatformFX\nglobal currentLevelWinCount\n\nput playingMovingPlatformFX into wasPlayingMovingPlatformFX\nif wasPlayingMovingPlatformFX = true then\nstopMovingPlatformFX\nend if\n\nput isMusicPlaying() into isPlaying\n\nif isPlaying then\npauseMusic\nend if\n\nadd 1 to winCount\nadd 1 to currentLevelWinCount\n\nlock screen\nshowDialogBox 256, 128, true\nshow card field \"sillyWinText\"\nshow button \"star1\"\nshow button \"star2\"\nshow button \"star3\"\nshow button \"balloon1\"\nshow button \"balloon2\"\nshow button \"sun1\"\nshow button \"sun2\"\nunlock screen\nput the ticks into pauseStartTime\n\nwait 10\nplaySillyFanfare\nwait 110\n\nlock screen\nhideSillyWinDialog\nunlock screen\n\nflushAllEvents\n\nif isPlaying then\nresumeMusic\nend if\n\nif wasPlayingMovingPlatformFX = true then\nstartMovingPlatformFX\nend if\n\nsend \"resetTimingAfterPause\" to button \"play\"\nend showSillyWinDialog\n\non hideSillyWinDialog\nhideDialogBox\nhide card field \"sillyWinText\" of card \"game\"\nhide button \"star1\" of card \"game\"\nhide button \"star2\" of card \"game\"\nhide button \"star3\" of card \"game\"\nhide button \"balloon1\" of card \"game\"\nhide button \"balloon2\" of card \"game\"\nhide button \"sun1\" of card \"game\"\nhide button \"sun2\" of card \"game\"\nend hideSillyWinDialog\n\non positionAndShowCommonHighscoreDialogElements\nset right of button \"OK\" to right of button \"boxOverlay3\" - 11\nset bottom of button \"OK\" to bottom of button \"boxOverlay3\" - 7\nset right of button \"Nah\" to left of button \"OK\" - 10\nset bottom of button \"Nah\" to bottom of button \"boxOverlay3\" - 11\n\nset left of card field \"highscoreNameLabel\" to ¬\nleft of button \"boxOverlay3\" + 6\nset bottom of card field \"highscoreNameLabel\" to ¬\nbottom of button \"boxOverlay3\" - 65\n\nset left of card field \"highscoreNameField\" to ¬\nleft of button \"boxOverlay3\" + 11\nset bottom of card field \"highscoreNameField\" to ¬\nbottom of button \"boxOverlay3\" - 45\n\nshow card field \"highscoreNameLabel\"\nshow card field \"highscoreNameField\"\nshow button \"Nah\"\nshow button \"OK\"\nend positionAndShowCommonHighscoreDialogElements\n\n\non maybeShowAppropriateEndGameDialog\nglobal speedrunMode\n\nif speedrunMode = true then\nreturn maybeShowSpeedrunHighScoresDialog()\nelse\nreturn maybeShowEndGameHighScoresDialog()\nend if\nend maybeShowAppropriateEndGameDialog\n\non setupEndGameDialog theText, showDecoration, extraHeight\nput the number of lines of theText into lineCount\n\nif lineCount = 0 then\nput extraHeight into dialogHeight\nhide card field \"highscoreGameEndText\"\nelse\nput extraHeight + 8 + lineCount * ¬\ntextHeight of card field \"highscoreGameEndText\" into dialogHeight\nshow card field \"highscoreGameEndText\"\nput theText into card field \"highscoreGameEndText\"\nend if\n\nshowDialogBox 296, dialogHeight, false\n\nif showDecoration = true then\nset top of button \"highscoreGameEndDecoration1\" to ¬\ntop of button \"boxOverlay3\" + 6\nset top of button \"highscoreGameEndDecoration2\" to ¬\ntop of button \"boxOverlay3\" + 6\nset top of button \"highscoreGameEndDecoration3\" to ¬\ntop of button \"boxOverlay3\" + 16\nset top of button \"highscoreGameEndDecoration4\" to ¬\ntop of button \"boxOverlay3\" + 16\nset top of button \"highscoreGameEndDecoration5\" to ¬\ntop of button \"boxOverlay3\" + 16\nset top of button \"highscoreGameEndDecoration6\" to ¬\ntop of button \"boxOverlay3\" + 16\nshow button \"highscoreGameEndDecoration1\"\nshow button \"highscoreGameEndDecoration2\"\nshow button \"highscoreGameEndDecoration3\"\nshow button \"highscoreGameEndDecoration4\"\nshow button \"highscoreGameEndDecoration5\"\nshow button \"highscoreGameEndDecoration6\"\nend if\n\nset rect of card field \"highscoreGameEndText\" to ¬\nleft of button \"boxOverlay3\" + 6,¬\ntop of button \"boxOverlay3\" + 8,¬\nright of button \"boxOverlay3\" - 6,¬\ntop of button \"boxOverlay3\" + 8 + ¬\n(textHeight of card field \"highscoreGameEndText\" * lineCount) + 2\nend setupEndGameDialog\n\nfunction maybeShowEndGameHighScoresDialog\nglobal maxLevelAtGameStart, wonGame, lastHighscoreName, deathCount\nglobal selectHighscoreNameField, finishedSingleLevelRun\n\nput line 2 of card field \"startLevel\" into startLevelNum\nput currentLevelNumber() into endLevelNum\nput true into enterHighScore\n\n-- put 123 into deathCount\n-- put 5 into maxLevelAtGameStart\n-- put 2 into startLevelNum\n-- put 20 into endLevelNum\n-- put true into wonGame\n\nif endLevelNum ≠ 20 then\nput false into wonGame\nend if\n\nif wonGame = true then\nplayCheer\nif startLevelNum = 1 then\nif deathCount = 0 then\nput \"Congratulations!\" & return & return & ¬\n\"You completed the whole game,\" & return & ¬\n\"starting from the first level, and\" & return & ¬\n\"without exploding even once! \" & return & ¬\n\"You're incredible!!!!!\" into theText\nelse if maxLevelAtGameStart ≠ 21 then\nput \"Congratulations!\" & return & return & ¬\n\"You completed the whole game,\" & return & ¬\n\"starting from the first level!\" & return & return & ¬\n\"... and you've unlocked the extra level!\" into theText\nelse\nput \"Congratulations!\" & return & return & ¬\n\"You completed the whole game,\" & return & ¬\n\"starting from the first level!\" into theText\nend if\n\nif getAscendingRankForDeaths(\"deathsAsc\", deathCount) > 100 then\nput false into enterHighScore\nend if\n\nelse\nif maxLevelAtGameStart ≠ 21 then\nput \"Congratulations!\" & return & return & ¬\n\"You completed the game!\" & return & return & ¬\n\"...and you've unlocked the extra level!\" into theText\nelse\nput \"Congratulations!\" & return & return & ¬\n\"You completed the game!\" into theText\nend if\n\nif deathCount = 0 or getDescendingRankForDeaths(deathCount) > 100 then\nput false into enterHighScore\nend if\nend if\n\nelse if endLevelNum = 21 then\nif not finishedSingleLevelRun then\nreturn false\nend if\n\nplayCheer\nif deathCount = 0 then\nput \"Congratulations!\" & return & return & ¬\n\"You beat the extra hard level . . .\" & return & ¬\n\"without exploding?! Really????????\" & return &¬\n\"You must be the greatest Blah Blob\" & return &¬\n\"player of all time!!\" into theText\nelse\nput \"Congratulations!\" & return & return & ¬\n\"You beat the extra hard level!\" into theText\nend if\n\nif getAscendingRankForDeaths(\"deathsExtra\", deathCount) > 100 then\nput false into enterHighScore\nend if\nelse\nif deathCount = 0 or getDescendingRankForDeaths(deathCount) > 100 then\nreturn false\nend if\n\nif endLevelNum = startLevelNum then\nreturn false\nend if\n\nplayKaChing\n\nif endLevelNum > maxLevelAtGameStart then\nif maxLevelAtGameStart+1 = endLevelNum then\nput \"You've unlocked Level \" & endLevelNum & \"!\" into theText\nelse if maxLevelAtGameStart+2 = endLevelNum then\nput \"You've unlocked Levels \" & (maxLevelAtGameStart+1) & ¬\n\" and \" & endLevelNum & \"!\" into theText\nelse\nput \"You've unlocked Levels \" & (maxLevelAtGameStart+1) & ¬\n\" - \" & endLevelNum & \"!\" into theText\nend if\nelse\nput empty into theText\nend if\nend if\n\nlock screen\nshowDarken\n\nif enterHighScore then\nsetupEndGameDialog theText, wonGame, 90\npositionAndShowCommonHighscoreDialogElements\nput lastHighscoreName into card field \"highscoreNameField\"\nput true into selectHighscoreNameField\nelse\nsetupEndGameDialog theText, (wonGame or endLevelNum = 21), 46\nset right of button \"Hooray!\" to right of button \"boxOverlay3\" - 11\nset bottom of button \"Hooray!\" to bottom of button \"boxOverlay3\" - 7\nshow button \"Hooray!\"\nend if\n\nunlock screen\n\nreturn true\nend maybeShowEndGameHighScoresDialog\n\nfunction maybeShowSpeedrunHighScoresDialog\nglobal lastHighscoreName, cycleCount, timeTrialMode\nglobal selectHighscoreNameField\n\nlock screen\nshowDarken\nshowDialogBox 296, 148, false\npositionAndShowCommonHighscoreDialogElements\n\nput gameCyclesToTime(cycleCount) into card field \"highscoreSpeedrunTime\"\n\nif timeTrialMode then\nput \"level\" & currentLevelNumber() into listType\nelse\nput \"speedruns\" into listType\nend if\n\nput getRankForTime(listType, cycleCount) into rank\n\nif rank > 100 then\nreturn false\nend if\n\nput timeForRank(listType, 1) into bestTime\n\nif bestTime is empty then\nput \"None\" into card field \"highscoreSpeedrunBestTime\"\nplayKaChing\nelse\nif rank = 1 then\nshow card field \"highscoreSpeedrunCongrats\"\nplayCheer\nelse\nplayKaChing\nend if\n\nput gameCyclesToTime(bestTime) into card field \"highscoreSpeedrunBestTime\"\nend if\n\nif rank = 1 then\nput \"Previous best time:\" into card field \"highscoreSpeedrunLabel3\"\nelse\nput \"Current best time:\" into card field \"highscoreSpeedrunLabel3\"\nend if\n\nput \"#\" & rank into card field \"highscoreSpeedrunRank\"\n\nshow card field \"highscoreSpeedrunLabel1\"\nshow card field \"highscoreSpeedrunLabel2\"\nshow card field \"highscoreSpeedrunLabel3\"\nshow card field \"highscoreSpeedrunTime\"\nshow card field \"highscoreSpeedrunRank\"\nshow card field \"highscoreSpeedrunBestTime\"\nput lastHighscoreName into card field \"highscoreNameField\"\nunlock screen\n\nput true into selectHighscoreNameField\nselect line 1 of card field \"highscoreNameField\"\n\nreturn true\nend maybeShowSpeedrunHighScoresDialog\n\non showAreYouSureDialog\nshowDarken\nshowDialogBox 312, 96, false\nshow card field \"areYouSureText\"\nshow button id 260\nshow button id 261\nend showAreYouSureDialog\n\non hideHighScoresDialog\nhideDarken\nhideDialogBox\nhide button \"highscoreGameEndDecoration1\" of card \"game\"\nhide button \"highscoreGameEndDecoration2\" of card \"game\"\nhide button \"highscoreGameEndDecoration3\" of card \"game\"\nhide button \"highscoreGameEndDecoration4\" of card \"game\"\nhide button \"highscoreGameEndDecoration5\" of card \"game\"\nhide button \"highscoreGameEndDecoration6\" of card \"game\"\nhide card field \"highscoreGameEndText\" of card \"game\"\nhide card field \"highscoreSpeedrunLabel1\" of card \"game\"\nhide card field \"highscoreSpeedrunLabel2\" of card \"game\"\nhide card field \"highscoreSpeedrunLabel3\" of card \"game\"\nhide card field \"highscoreSpeedrunTime\" of card \"game\"\nhide card field \"highscoreSpeedrunRank\" of card \"game\"\nhide card field \"highscoreSpeedrunBestTime\" of card \"game\"\nhide card field \"highscoreSpeedrunCongrats\" of card \"game\"\nhide card field \"highscoreNameLabel\" of card \"game\"\nhide card field \"highscoreNameField\" of card \"game\"\nhide card field \"areYouSureText\" of card \"game\"\nhide button id 260 of card \"game\"\nhide button id 261 of card \"game\"\nhide button \"Nah\" of card \"game\"\nhide button \"OK\" of card \"game\"\nhide button \"Hooray!\" of card \"game\"\nend hideHighScoresDialog\n\non doNahButton doNumberOneCheck\nglobal speedrunMode, timeTrialMode, deathCount\nput line 2 of card field \"startLevel\" into startLevelNum\n\nif doNumberOneCheck = true and ¬\n((speedrunMode and card field \"highscoreSpeedrunRank\" = \"#1\") or ¬\n(not speedrunMode and startLevelNum = 1 and deathCount = 0) or ¬\n(not speedrunMode and startLevelNum = 21 and deathCount = 0)) then\nlock screen\nhideHighScoresDialog\nshowAreYouSureDialog\nunlock screen\nbeep\n\nexit doNahButton\nend if\n\ngoToBlack\n\nif timeTrialMode then\nanswer \"Retry the level?\" with \"No\" or \"Yes\"\nif it is yes then\nretryLevel\nexit doNahButton\nend if\nend if\n\ngoBackToTitleWhenAlreadyBlack\nend doNahButton\n\non retryLevel\nsetLevelTo (line 2 of card field \"startLevel\")\nhideHighScoresDialog\nwait 15\nsend \"startGame\" to button \"play\"\nend retryLevel\n\non doLetMeEnterMyNameButton\nlock screen\nhideHighScoresDialog\nmaybeShowAppropriateEndGameDialog\nunlock screen\nend doLetMeEnterMyNameButton\n\non submitHighscore\nglobal speedrunMode, timeTrialMode, cycleCount, lastHighscoreName\nglobal deathCount, wonGame, winCount\nglobal levelDeaths, levelWins, levelTimes\nput line 2 of card field \"startLevel\" into startLevelNum\nput currentLevelNumber() into endLevelNum\n\nput card field \"highscoreNameField\" into theName\n\nif return is in theName or formfeed is in theName then\nbeep\nexit submitHighscore\nend if\n\nput theName into lastHighscoreName\n\nif timeTrialMode then\nput \"level\" & currentLevelNumber() into listType\nput getRankForTime(listType, cycleCount) into rank\n\naddSingleLevelHighScoreEntry listType, rank, theName, ¬\ndeathCount, winCount, cycleCount\n\nput listType into hiliteListType\nput rank into hiliteRank\nelse if speedrunMode then\nput getRankForTime(\"speedruns\", cycleCount) into rank\n\naddGameHighScoreEntry \"speedruns\", rank, theName, startLevelNum, ¬\nendLevelNum, deathCount, winCount, cycleCount, ¬\nlevelDeaths, levelWins, levelTimes\n\nput \"speedruns\" into hiliteListType\nput rank into hiliteRank\nelse if endLevelNum = 21 then\nput getAscendingRankForDeaths(\"deathsExtra\", deathCount) into rank\n\naddSingleLevelHighScoreEntry \"deathsExtra\", rank, theName, ¬\ndeathCount, winCount, cycleCount\n\nput \"deathsExtra\" into hiliteListType\nput rank into hiliteRank\n\nelse\nput false into addedToDeathsAsc\n\nif wonGame and startLevelNum = 1 then\nput getAscendingRankForDeaths(\"deathsAsc\", deathCount) into rankAsc\n\nif rankAsc ≤ 100 then\naddGameHighScoreEntry \"deathsAsc\", rankAsc, theName, startLevelNum, ¬\nendLevelNum, deathCount, winCount, cycleCount, ¬\nlevelDeaths, levelWins, levelTimes\nput true into addedToDeathsAsc\nend if\nend if\n\nput getDescendingRankForDeaths(deathCount) into rankDec\naddGameHighScoreEntry \"deathsDec\", rankDec, theName, startLevelNum, ¬\nendLevelNum, deathCount, winCount, cycleCount, ¬\nlevelDeaths, levelWins, levelTimes\n\nput button \"discoveredDeathsAsc\" of card \"high scores\" ¬\ninto discoveredNonsillyDeathOrder\n\nif addedToDeathsAsc and ¬\n(discoveredNonsillyDeathOrder or deathCount = 0 or rankDec > 100) then\nput \"deathsAsc\" into hiliteListType\nput rankAsc into hiliteRank\nelse\nput \"deathsDec\" into hiliteListType\nput rankDec into hiliteRank\nend if\nend if\n\nlock screen\nsend \"hideHighScoresDialog\" to button \"dialogs\"\nshow button \"blackOverlay\"\nunlock screen with visual effect iris close\n\nif timeTrialMode = true then\nanswer \"Retry the level?\" with \"No\" or \"Yes\"\n\nif it is yes then\nretryLevel\nexit submitHighscore\nend if\nend if\n\nfadeMusicWhenLeavingGame\n\nlock screen\nhide button \"blackOverlay\"\nleaveGame \"high scores\"\nhiliteHighScore hiliteListType, hiliteRank\nunlock screen with visual effect iris open\nend submitHighscore\n\non mouseUp\nif visible of button \"boxoverlay1\" or visible of card field \"pauseText\" then\nhideHighScoresDialog\nhidePauseDialog\nelse\nlock screen\nmaybeShowAppropriateEndGameDialog\nunlock screen\nend if\nend mouseUp",
          "visible": false,
