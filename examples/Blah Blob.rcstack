        {
          "id": 58,
          "kind": "Button",
          "name": "tileHandlers",
          "rect": {
            "left": 464,
            "top": 34,
            "right": 512,
            "bottom": 48
          },
          "script": "on checkpoint tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal lastGroundY, checkpointLastGroundY, checkpointTilePos\nglobal scrollY\n\nif tileAtTilePos(tilePosX, tilePosY) = \"Y\" then\nsetMapTile \"k\", checkpointTilePos\nend if\n\nput lastGroundY into checkpointLastGroundY\n\nput tilePosX & \",\" & tilePosY into checkpointTilePos\nsetMapTile \"|\", checkpointTilePos\n\nplayCheckpointFX (currentLevelNumber() ≥ 20 and scrollY < 500)\n\nreturn false\nend checkpoint\n\n\non endUpperLeft tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal winPos\nput tilePosX & \",\" & tilePosY into winPos\nwin\nreturn true\nend endUpperLeft\n\non endUpperRight tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal winPos\nput tilePosX-1 & \",\" & tilePosY into winPos\nwin\nreturn true\nend endUpperRight\n\non endLowerLeft tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal winPos\nput tilePosX & \",\" & tilePosY-1 into winPos\nwin\nreturn true\nend endLowerLeft\n\non endLowerRight tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal winPos\nput tilePosX-1 & \",\" & tilePosY-1 into winPos\nwin\nreturn true\nend endLowerRight\n\n\non offSwitchTop tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal inSensitiveTileX, inSensitiveTileY\n\nif char 2 of direction = \"x\" then\nput \"t\" into char 1 of inSensitiveTileX\nelse\nput \"t\" into char 1 of inSensitiveTileY\nend if\n\nif direction ≠ \"+x\" then return false\n\nplayLever2\ntriggerSwitch (tilePosX & \",\" & tilePosY), \"=\"\nreturn true\nend offSwitchTop\n\non offSwitchBottom tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal inSensitiveTileX, inSensitiveTileY\n\nif char 2 of direction = \"x\" then\nput \"t\" into char 1 of inSensitiveTileX\nelse\nput \"t\" into char 1 of inSensitiveTileY\nend if\n\nif direction ≠ \"+x\" then return false\n\nplayLever2\ntriggerSwitch (tilePosX & \",\" & tilePosY-1), \"=\"\nreturn true\nend offSwitchBottom\n\non onSwitchTop tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal inSensitiveTileX, inSensitiveTileY\n\nif char 2 of direction = \"x\" then\nput \"t\" into char 1 of inSensitiveTileX\nelse\nput \"t\" into char 1 of inSensitiveTileY\nend if\n\nif direction ≠ \"-x\" then return false\n\nplayLever1\ntriggerSwitch (tilePosX & \",\" & tilePosY), \"+\"\nreturn true\nend onSwitchTop\n\non onSwitchBottom tilePosX, tilePosY, direction, newX, newY, xi, yi\nglobal inSensitiveTileX, inSensitiveTileY\n\nif char 2 of direction = \"x\" then\nput \"t\" into char 1 of inSensitiveTileX\nelse\nput \"t\" into char 1 of inSensitiveTileY\nend if\n\nif direction ≠ \"-x\" then return false\n\nplayLever1\ntriggerSwitch (tilePosX & \",\" & tilePosY-1), \"+\"\nreturn true\nend onSwitchBottom\n\non triggerOnButton tilePosX, tilePosY, offTile, onTile, pressedTile\nput tilePosX & \",\" & tilePosY into buttonPos\nsetMapTile pressedTile, buttonPos\naddAnimatingTile buttonPos, onTile, 6\nplayButton1\nsend \"triggerButton \" & quote & buttonPos & quote & \", true\" to button \"play3\"\nend triggerOnButton\n\non triggerOffButton tilePosX, tilePosY, offTile, onTile, pressedTile\nput tilePosX & \",\" & tilePosY into buttonPos\nsetMapTile pressedTile, buttonPos\naddAnimatingTile buttonPos, offTile, 6\nplayButton2\nsend \"triggerButton \" & quote & buttonPos & quote & \", false\" to button \"play3\"\nend triggerOffButton\n\non leftOffButton tilePosX, tilePosY, direction\nif direction ≠ \"-x\" then return false\ntriggerOffButton tilePosX, tilePosY, \"V\", \"B\", \"<\"\nreturn true\nend leftOffButton\n\non leftOnButton tilePosX, tilePosY, direction\nif direction ≠ \"-x\" then return false\ntriggerOnButton tilePosX, tilePosY, \"V\", \"B\", \"<\"\nreturn true\nend leftOnButton\n\non rightOffButton tilePosX, tilePosY, direction\nif direction ≠ \"+x\" then return false\ntriggerOffButton tilePosX, tilePosY, \"√\", \"∫\", \"≤\"\nreturn true\nend rightOffButton\n\non rightOnButton tilePosX, tilePosY, direction\nif direction ≠ \"+x\" then return false\ntriggerOnButton tilePosX, tilePosY, \"√\", \"∫\", \"≤\"\nreturn true\nend rightOnButton\n\non downOffButton tilePosX, tilePosY, direction\nif direction ≠ \"+y\" then return false\ntriggerOffButton tilePosX, tilePosY, \"v\", \"b\", \"¯\"\nreturn false\nend downOffButton\n\non downOnButton tilePosX, tilePosY, direction\nif direction ≠ \"+y\" then return false\ntriggerOnButton tilePosX, tilePosY, \"v\", \"b\", \"¯\"\nreturn false\nend downOnButton\n\non upOffButton tilePosX, tilePosY, direction\nif direction ≠ \"-y\" then return false\ntriggerOffButton tilePosX, tilePosY, \"◊\", \"ı\", \">\"\nreturn false\nend upOffButton\n\non upOnButton tilePosX, tilePosY, direction\nif direction ≠ \"-y\" then return false\ntriggerOnButton tilePosX, tilePosY, \"◊\", \"ı\", \">\"\nreturn false\nend upOnButton\n\n\n\nfunction checkSpringTiles tilePosX, tilePosY, direction, ¬\ndownTile, midTile, upTile, dx, dy, rx1, ry1, rx2, ry2, newX, newY\n\nglobal springed, playerDX, playerDY, playerSlideCount\nglobal playerFloatUpCount, inSensitiveTileX, inSensitiveTileY\n\nif char 2 of direction = \"x\" then\nput \"t\" into char 1 of inSensitiveTileX\nelse\nput \"t\" into char 1 of inSensitiveTileY\nend if\n\n\nput ((tilePosX-1) * 16 + rx1) & \",\" & ((tilePosY-1) * 16 + ry1) ¬\ninto matchingPos\n\n-- NB: HyperCard's \"is within\" operator considers landing on the\n-- left and top edge of a rect as being within, but *not* the right\n-- and bottom edge!\nput (newX-rx2+rx1) & \",\" & (newY-ry2+ry1) & \",\" & (newX+25) & \",\" ¬\n& (newY+25) into collisionRect\n\nif matchingPos is not within collisionRect then\nreturn false\nend if\n\nput tilePosX & \",\" & tilePosY into matchingTilePos\nsetMapTile midTile, matchingTilePos\naddAnimatingTile matchingTilePos, upTile, 2\naddAnimatingTile matchingTilePos, midTile, 12\naddAnimatingTile matchingTilePos, downTile, 14\n\nif dy ≠ 0 then\nput dy into playerDY\nput 5 into playerFloatUpCount\nelse\nput dx into playerDX\nput 9 into playerSlideCount\nend if\n\nput true into springed\n\nplaySpringFX\n\nif direction = \"-x\" then\nplayAnim \"leftBigBounce\"\nelse if direction = \"+x\" then\nplayAnim \"rightBigBounce\"\nelse if direction = \"-y\" then\nplayAnim \"topBigBounce\"\nelse\nplayAnim \"bottomBigBounce\"\nend if\n\nreturn true\nend checkSpringTiles\n\non leftSpring tilePosX, tilePosY, direction, newX, newY, xi, yi\nreturn checkSpringTiles(tilePosX, tilePosY, direction, ¬\n\"¬\", \"Ò\", \"Ó\", -16, 0,     5, 2, 16, 14, newX, newY)\nend leftSpring\n\non upSpring tilePosX, tilePosY, direction, newX, newY, xi, yi\nreturn checkSpringTiles(tilePosX, tilePosY, direction, ¬\n\"˚\", \"\", \"˝\", 0, -16,     2, 5, 14, 16, newX, newY)\nend upSpring\n\non rightSpring tilePosX, tilePosY, direction, newX, newY, xi, yi\nreturn checkSpringTiles(tilePosX, tilePosY, direction, ¬\n\"∆\", \"Ô\", \"Ï\", 16, 0,     0, 2, 11, 14, newX, newY)\nend rightSpring\n\non downSpring tilePosX, tilePosY, direction, newX, newY, xi, yi\nreturn checkSpringTiles(tilePosX, tilePosY, direction, ¬\n\"ø\", \"Ø\", \"ˇ\", 0, 16,     2, 0, 14, 11, newX, newY)\nend downSpring\n\n",
