        {
          "id": 30,
          "kind": "Button",
          "name": "levelSelectionButton",
          "rect": {
            "left": 102,
            "top": 9,
            "right": 410,
            "bottom": 305
          },
          "script": "on mouseDown\nmaybeSelectLineUnderMouse\nend mouseDown\n\non mouseStillDown\nmaybeSelectLineUnderMouse\nend mouseStillDown\n\non mouseDoubleClick\nif enabled of button \"Go!\" then\nsend \"mouseUp\" to button \"Go!\"\nend if\nend mouseDoubleClick\n\non maybeSelectLineUnderMouse\nput (the mouseV - top of card field \"levels\" - 1) div ¬\n(textHeight of card field \"levels\") + 1 into theLine\nmaybeSelectLine theLine\nend maybeSelectLineUnderMouse\n\non maybeSelectLine theLine\nif theLine < 1 or theLine > the number of lines of cd field \"levels\" then exit maybeSelectLine\nif \"not yet available!\" is in line theLine of card field \"levels\" then\nexit maybeSelectLine\nend if\n\nset topLeft of button \"levelSelection\" to ¬\nleft of card field \"levels\" + 1, ¬\ntop of card field \"levels\" + ¬\n(textHeight of card field \"levels\" * (theLine - 1)) + 1\nshow button \"levelSelection\"\nput theLine into button \"levelSelection\"\nset enabled of button \"Go!\" to true\nend maybeSelectLine\n\n-- on mouseDown\n-- put word 2 of the clickLine into clickedLevelNumber\n\n-- put textHeight of me into lineHeight\n-- if clickedLevelNumber is empty or clickedLevelNumber < 1 or ¬\n-- clickedLevelNumber > the number of lines of me then exit mouseDown\n\n-- set width of button \"levelSelection\" to width of me - 2\n-- set height of button \"levelSelection\" to lineHeight+1\n-- show button \"levelSelection\"\n-- set topLeft of button \"levelSelection\" to ¬\n-- left of me + 1, ¬\n-- top of me + lineHeight * clickedLevelNumber - lineHeight + 1\n\n-- repeat until the mouse is up\n-- if the mouseLoc is within rect of button \"levelSelection\" then\n-- show button \"levelSelection\"\n-- else\n-- hide button \"levelSelection\"\n-- end if\n-- wait 1\n-- end repeat\n\n-- if not visible of button \"levelSelection\" then exit mouseDown\n\n-- lock screen\n-- setVisibleOfLevelSelectionStuffWithoutLockingScreen false\n-- startAtLevelWithAlreadyLockedScreen clickedLevelNumber\n-- end mouseDown",
          "visible": false,
