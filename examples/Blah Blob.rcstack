        {
          "id": 232,
          "kind": "Field",
          "name": "highscoreNameField",
          "rect": {
            "left": 119,
            "top": 182,
            "right": 393,
            "bottom": 200
          },
          "script": "on keyDown theKey\nif theKey = return then\nif enabled of button id 233 then\nsend \"mouseUp\" to button id 233\nend if\nexit keyDown\nend if\n\nif the number of chars of me ≥ 100 and theKey ≠ \"\b\" and ¬\nthe number of chars of the selectedText = 0 then\nplay stop\nplay \"boing\"\nexit keyDown\nend if\n\nif cantModify of this stack then\n-- Need to basically reimplement typing otherwise the user\n-- can't type in the text field!!\nput word 2 of the selectedChunk into startChar\nput word 4 of the selectedChunk into endChar\n\nif theKey = \"\b\" then -- backspace key\nif startChar ≤ endChar then\ndelete the selectedChunk\nselect char startChar+1 to startChar of me\nelse\ndelete char endChar of me\nselect char endChar to endChar-1 of me\nend if\nexit keyDown\nend if\n\nput theKey into char startChar to endChar of me\nselect char startChar+1 to startChar of me\nelse\npass keyDown\nend if\nend keyDown",
          "visible": false,
          "style": "Rectangle",
          "text_font": "Helvetica",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "",
          "hilite": false,
          "auto_hilite": false,
          "show_name": false,
          "enabled": true,
          "family": 0,
