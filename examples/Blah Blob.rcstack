          },
          "script": "on mouseUp\nhide card field \"_tiles1\"\nhide card field \"_tiles3\"\nshow card field \"_tiles2\"\n\nhide card button \"selected\"\nclick at (left of card field \"_tiles1\" + 10 & \",\" & ¬\ntop of card field \"_tiles1\" + 5)\nend mouseUp",
