        {
          "id": 22,
          "kind": "Button",
          "name": "autotile",
          "rect": {
            "left": 479,
            "top": 330,
            "right": 512,
            "bottom": 342
          },
          "script": "on mouseUp\nif the optionKey is down then\nanswer \"Restore from backup????\" with \"Yes\" or \"No\"\nif it is not \"yes\" then exit mouseUp\nput card field \"_backup\" into card field currentLevel()\nexit mouseUp\nend if\n\nanswer \"Automatically add edges to wall tiles?\" with \"Yes\" or \"No\"\nif it is not \"yes\" then exit mouseUp\n\nput (textSize of card field currentLevel() = 21) into enableDiags\n\nput card field currentLevel() into map\nput map into card field \"_backup\"\n\nput the number of lines of map into lineCount\n\nset cursor to watch\n\nput empty into processedMap\nput empty into prevLine\nput empty into curLine\nput line 1 of map into nextLine\n\nrepeat with y = 1 to lineCount\nput \"Preprocessing:\" && (y * 100 / lineCount) & \"%...\"\nput curLine into prevLine\nput nextLine into curLine\nput line (y+1) of map into nextLine\n\nput the number of chars of curLine into curLineCharCount\n\nrepeat with x = 1 to curLineCharCount\nput char x of curLine into theChar\n\nif theChar is in \"123456789\" then\nnext repeat\nend if\n\nif theChar = \"s\" then\nput \"s\" after processedMap\nelse if WALL(theChar) then\nput \"w\" after processedMap\nelse\nput \" \" after processedMap\nend if\nend repeat\n\nput return after processedMap\nend repeat\n\nput empty into newMap\n\nput empty into prevLine\nput empty into curLine\nput line 1 of map into nextLine\n\nput empty into prevLineProcessed\nput empty into curLineProcessed\nput line 1 of processedMap into nextLineProcessed\n\nrepeat with y = 1 to lineCount\nput \"Adjusting tiles:\" && (y * 100 / lineCount) & \"%...\"\n\nput curLine into prevLine\nput nextLine into curLine\nput line (y+1) of map into nextLine\n\nput the number of chars of curLine into curLineCharCount\n\nput curLineProcessed into prevLineProcessed\nput nextLineProcessed into curLineProcessed\nput line (y+1) of processedMap into nextLineProcessed\n\nput 0 into x\n\nrepeat with xx = 1 to curLineCharCount\nif char xx of curLine is in \"123456789\" then\nnext repeat\nend if\n\nadd 1 to x\n\nif char x of curLineProcessed ≠ \"s\" then\nnext repeat\nend if\n\nif not enableDiags then\nif x > 1 then\nput char x-1 of curLineProcessed is in \"sw\" into left\nelse\nput true into left\nend if\n\nif y > 1 then\nput char x of prevLineProcessed is in \"sw\" into above\nelse\nput true into above\nend if\n\nif x < 26 then\nput char x+1 of curLineProcessed is in \"sw\" into right\nelse\nput true into right\nend if\n\nif y < lineCount then\nput char x of nextLineProcessed is in \"sw\" into below\nelse\nput true into below\nend if\n\nif not left and not above and not right and not below then\nput \"S\" into char xx of curLine\n\nelse if not left and not above and right and below then\nput \"q\" into char xx of curLine\n\nelse if left and not above and not right and below then\nput \"e\" into char xx of curLine\n\nelse if not left and above and right and not below then\nput \"z\" into char xx of curLine\n\nelse if left and above and not right and not below then\nput \"c\" into char xx of curLine\n\nelse if left and not above and right and not below then\nput \"Z\" into char xx of curLine\n\nelse if not left and above and not right and below then\nput \"Q\" into char xx of curLine\n\nelse if not left and above and right and below then\nput \"a\" into char xx of curLine\n\nelse if left and not above and right and below then\nput \"w\" into char xx of curLine\n\nelse if left and above and not right and below then\nput \"d\" into char xx of curLine\n\nelse if left and above and right and not below then\nput \"x\" into char xx of curLine\n\nelse if left and not above and not right and not below then\nput \"D\" into char xx of curLine\n\nelse if not left and above and not right and not below then\nput \"X\" into char xx of curLine\n\nelse if not left and not above and right and not below then\nput \"A\" into char xx of curLine\n\nelse if not left and not above and not right and below then\nput \"W\" into char xx of curLine\nend if\nelse\n\n\nif x > 1 then\nput char x-1 of curLineProcessed is in \"sw\" into left\nelse\nput true into left\nend if\n\nif y > 1 then\nput char x of prevLineProcessed is in \"sw\" into _up\nelse\nput true into _up\nend if\n\nif x < 26 then\nput char x+1 of curLineProcessed is in \"sw\" into right\nelse\nput true into right\nend if\n\nif y < lineCount then\nput char x of nextLineProcessed is in \"sw\" into _down\nelse\nput true into _down\nend if\n\nif x > 1 and y > 1 then\nput char x-1 of prevLineProcessed is in \"sw\" into upleft\nelse\nput true into upleft\nend if\n\nif x < 26 and y > 1 then\nput char x+1 of prevLineProcessed is in \"sw\" into upright\nelse\nput true into upright\nend if\n\nif x > 1 and y < lineCount then\nput char x-1 of nextLineProcessed is in \"sw\" into downleft\nelse\nput true into downleft\nend if\n\nif x < 26 and y < lineCount then\nput char x+1 of nextLineProcessed is in \"sw\" into downright\nelse\nput true into downright\nend if\n\nif not left and not _up and not right and not _down then\nput \"S\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nnot upleft and not upright and not downleft and not downright then\nput \"Â\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nupleft and not upright and not downleft and downright then\nput \"Ç\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nnot upleft and upright and downleft and downright then\nput \"å\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nupleft and not upright and downleft and downright then\nput \"ß\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nupleft and upright and not downleft and downright then\nput \"Ω\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nupleft and upright and downleft and not downright then\nput \"≈\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nnot upleft and not upright and downleft and downright then\nput \"Å\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nupleft and not upright and not downright and downleft then\nput \"˘\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nupleft and upright and not downright and not downleft then\nput \"˛\" into char xx of curLine\n\nelse if left and _up and right and _down and ¬\nnot upleft and upright and downright and not downleft then\nput \"¸\" into char xx of curLine\n\nelse if not _up and right and ¬\ndownright and _down and not downleft and left then\nput \"£\" into char xx of curLine\n\nelse if not _up and right and ¬\nnot downright and _down and downleft and left then\nput \"¢\" into char xx of curLine\n\nelse if not upLeft and _up and upRight and right and ¬\nnot _down and left then\nput \"∞\" into char xx of curLine\n\nelse if upLeft and _up and not upRight and right and ¬\nnot _down and left then\nput \"§\" into char xx of curLine\n\nelse if not _up and right and ¬\nnot downright and _down and not left then\nput \"∂\" into char xx of curLine\n\nelse if not _up and not right and ¬\n_down and not downleft and left then\nput \"®\" into char xx of curLine\n\nelse if _up and not upRight and right and ¬\nnot _down and not left then\nput \"ç\" into char xx of curLine\n\nelse if not upLeft and _up and not right and ¬\nnot _down and left then\nput \"ƒ\" into char xx of curLine\n\nelse if _up and not upRight and right and ¬\ndownright and _down and not left then\nput \"¶\" into char xx of curLine\n\nelse if not upLeft and _up and not right and ¬\n_down and downleft and left then\nput \"•\" into char xx of curLine\n\nelse if _up and upRight and right and ¬\nnot downright and _down and not left then\nput \"ª\" into char xx of curLine\n\nelse if upLeft and _up and not right and ¬\n_down and not downleft and left then\nput \"˜\" into char xx of curLine\n\nelse if not _up and right and ¬\nnot downright and _down and not downleft and left then\nput \"©\" into char xx of curLine\n\nelse if _up and not upRight and right and ¬\nnot downright and _down and not left then\nput \"˙\" into char xx of curLine\n\nelse if not upLeft and _up and not right and ¬\n_down and not downleft and left then\nput \"¥\" into char xx of curLine\n\nelse if not upLeft and _up and not upRight and right and ¬\nnot _down and left then\nput \"†\" into char xx of curLine\n\n\nelse if not left and not _up and right and _down then\nput \"q\" into char xx of curLine\n\nelse if left and not _up and not right and _down then\nput \"e\" into char xx of curLine\n\nelse if not left and _up and right and not _down then\nput \"z\" into char xx of curLine\n\nelse if left and _up and not right and not _down then\nput \"c\" into char xx of curLine\n\nelse if left and not _up and right and not _down then\nput \"Z\" into char xx of curLine\n\nelse if not left and _up and not right and _down then\nput \"Q\" into char xx of curLine\n\nelse if not left and _up and right and _down then\nput \"a\" into char xx of curLine\n\nelse if left and not _up and right and _down then\nput \"w\" into char xx of curLine\n\nelse if left and _up and not right and _down then\nput \"d\" into char xx of curLine\n\nelse if left and _up and right and not _down then\nput \"x\" into char xx of curLine\n\nelse if left and not _up and not right and not _down then\nput \"D\" into char xx of curLine\n\nelse if not left and _up and not right and not _down then\nput \"X\" into char xx of curLine\n\nelse if not left and not _up and right and not _down then\nput \"A\" into char xx of curLine\n\nelse if not left and not _up and not right and _down then\nput \"W\" into char xx of curLine\n\nend if\n\n\n\nend if\nend repeat\n\nput curLine & return after newMap\nend repeat\n\nif last char of newMap = return then delete last char of newMap\nput newMap into card field currentLevel()\n\nplay \"boing\"\n\nend mouseUp\n\nfunction WALL tile\nreturn tile is in \"qweWasdQzxcXAZDSåßÇΩ≈ÂÅ¸˘˛£¢∂®∞§çƒ¶•ª˜©˙¥†\"\nend WALL\n\nfunction bare tile\nreturn not wall(tile)\nend bare\n\n\non autoTileDramaticTileset\n\nend autoTileDramaticTileset",
