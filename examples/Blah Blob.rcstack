    {
      "id": 12168,
      "name": "data",
      "script": "on doScrollSync targetField\nput theFields(targetField) into fieldList\nif the selectedField is not empty then exit doScrollSync\nput the scroll of card field targetField into newScroll\n\nif newScroll ≠ scroll of (item 1 of fieldList) or ¬\nnewScroll ≠ scroll of (item 2 of fieldList) then\nlock screen\nrepeat with count = 1 to (number of items in fieldList)\nset scroll of (item count of fieldList) to newScroll\nend repeat\nunlock screen\nend if\nend doScrollSync\n\nfunction theFields dataName\nput offset(\"_\", dataName) into separator\nput char 1 to separator of dataName into baseName\n\nput \"card field id\" && id of card field (baseName & \"names\") into val\nput \",card field id\" && id of card field (baseName & \"data\") after val\n\nif there is a card field (baseName & \"levelDeaths\") then\nput \",card field id\" && id of card field (baseName & \"levelDeaths\") after val\nend if\nif there is a card field (baseName & \"levelWins\") then\nput \",card field id\" && id of card field (baseName & \"levelWins\") after val\nend if\nif there is a card field (baseName & \"levelTimes\") then\nput \",card field id\" && id of card field (baseName & \"levelTimes\") after val\nend if\n\nreturn val\nend theFields\n",
      "background": 2568,
      "parts": [
        {
          "id": 2,
          "kind": "Field",
          "name": "deathsDec_data",
          "rect": {
            "left": 136,
            "top": 5,
            "right": 224,
            "bottom": 335
          },
          "script": "on mouseWithin\ndoScrollSync (the short name of me)\nend mouseWithin\n",
          "visible": false,
          "style": "Scrolling",
          "text_font": "Geneva",
          "text_size": 9,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "",
          "hilite": false,
          "auto_hilite": false,
          "show_name": false,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": false,
          "dont_wrap": true,
          "auto_tab": false,
          "wide_margins": false,
          "show_lines": true,
          "shared_text": false,
          "dont_search": false,
          "auto_select": false,
          "multiple_lines": false,
          "text_height": 0,
          "fixed_line_height": true,
          "scroll": 0
        },
        {
          "id": 3,
          "kind": "Button",
          "name": "listType",
          "rect": {
            "left": 393,
            "top": 6,
            "right": 502,
            "bottom": 25
          },
          "script": "on mouseUp\nput the selectedText of me into baseName\n\nput \"deathsDec_names\" into baseNamesField\nput \"deathsDec_data\" into baseDataField\n\n-- repeat with i = 1 to the number of lines of me\n-- put (line i of me) & \"_names\" into namesName\n-- put (line i of me) & \"_data\" into dataName\n\n-- if there is not a card field namesName then\n-- show card field baseNamesField\n-- select card field baseNamesField\n-- doMenu \"Copy field\"\n-- doMenu \"Paste field\"\n-- put the id of last card field into newFieldId\n-- set name of card field id newFieldId to namesName\n-- end if\n\n-- if there is not a card field dataName then\n-- show card field baseDataField\n-- select card field baseDataField\n-- doMenu \"Copy field\"\n-- doMenu \"Paste field\"\n-- put the id of last card field into newFieldId\n-- set name of card field id newFieldId to dataName\n-- end if\n\n-- set rect of card field namesName to rect of card field baseNamesField\n-- set textFont of card field namesName to textFont of card field baseNamesField\n-- set textSize of card field namesName to textSize of card field baseNamesField\n-- set textStyle of card field namesName to textStyle of card field baseNamesField\n-- set rect of card field dataName to rect of card field baseDataField\n-- set textFont of card field dataName to textFont of card field baseDataField\n-- set textSize of card field dataName to textSize of card field baseDataField\n-- set textStyle of card field dataName to textStyle of card field baseDataField\n-- end repeat\n\nrepeat with i = 1 to the number of lines of me\nhide card field ((line i of me) & \"_names\")\nhide card field ((line i of me) & \"_data\")\n\nif there is a card field ((line i of me) & \"_levelDeaths\") then\nhide card field ((line i of me) & \"_levelDeaths\")\nend if\nif there is a card field ((line i of me) & \"_levelWins\") then\nhide card field ((line i of me) & \"_levelWins\")\nend if\nif there is a card field ((line i of me) & \"_levelTimes\") then\nhide card field ((line i of me) & \"_levelTimes\")\nend if\nend repeat\n\nshow card field (baseName & \"_names\")\nshow card field (baseName & \"_data\")\n\nif there is a card field (baseName & \"_levelDeaths\") then\nshow card field (baseName & \"_levelDeaths\")\n-- set rect of card field (baseName & \"_levelDeaths\") to ¬\n-- rect of card field (\"deathsDec_levelDeaths\")\nend if\nif there is a card field (baseName & \"_levelWins\") then\nshow card field (baseName & \"_levelWins\")\n-- set rect of card field (baseName & \"_levelWins\") to ¬\n-- rect of card field (\"deathsDec_levelWins\")\nend if\nif there is a card field (baseName & \"_levelTimes\") then\nshow card field (baseName & \"_levelTimes\")\n-- set rect of card field (baseName & \"_levelTimes\") to ¬\n-- rect of card field (\"deathsDec_levelTimes\")\nend if\n\nchoose browse tool\nend mouseUp",
          "visible": true,
          "style": "Popup",
          "text_font": "Chicago",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "deathsDec\ndeathsAsc\nspeedruns\nlevel1\nlevel2\nlevel3\nlevel4\nlevel5\nlevel6\nlevel7\nlevel8\nlevel9\nlevel10\nlevel11\nlevel12\nlevel13\nlevel14\nlevel15\nlevel16\nlevel17\nlevel18\nlevel19\nlevel20\nlevel21\ndeathsExtra",
          "hilite": false,
          "auto_hilite": true,
          "show_name": false,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
