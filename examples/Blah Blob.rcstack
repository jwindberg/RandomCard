        {
          "id": 3,
          "kind": "Button",
          "name": "Start At...",
          "rect": {
            "left": 394,
            "top": 278,
            "right": 490,
            "bottom": 298
          },
          "script": "on mouseUp\nput card field \"_levelOrder\" of card  \"levels\" into levelOrder\nput maxLevelPlayed() into maxLevelNum\n\nput textFont of card field \"levels\" into levelsTextFont\nput textSize of card field \"levels\" into levelsTextSize\n\nif getSpeedrunModeEnabled() then\nput 245 into maxWidth\nelse\nput 151 into maxWidth\nend if\n\nlock screen\nput empty into card field \"levels\"\n\nrepeat with i = 1 to the number of lines of levelOrder\nif i ≤ maxLevelNum then\nif i < 10 then\nif maxLevelNum < 10 then\nput \" Level \" & i & \" — \" into levelText\nelse\nput \" Level \" & i & \"  — \" into levelText\nend if\nelse if i ≤ 20 then\nput \" Level \" & i & \" — \" into levelText\nelse\nput \"     Extra!       — \" into levelText\nend if\nput levelText & ¬\nshortLevelDisplayNameForLevelName(line i of levelOrder) ¬\n& return after card field \"levels\"\nput textWidth(line i of card field \"levels\", levelsTextFont, ¬\nlevelsTextSize, \"bold\") into lineWidth\nelse\nput \" Level \" & i & \" not yet available!\" & return ¬\nafter card field \"levels\"\nput textWidth(line i of card field \"levels\", levelsTextFont, ¬\nlevelsTextSize, \"plain\")+1 into lineWidth\nend if\n\nput max(lineWidth, maxWidth) into maxWidth\nend repeat\n\nset textStyle of line 1 to min(maxLevelNum,20) of card field \"levels\" to \"bold\"\n\nif maxLevelNum = 21 then\nput 21 * 14 + 2 into finalHeight\nset textStyle of char 6 to 11 of line 21 of card field \"levels\" to \"underline\"\nset textStyle of char 12 to 18 of line 21 of card field \"levels\" to \"condense\"\nset textStyle of char 19 to 100 of line 21 of card field \"levels\" to \"bold,italic\"\nelse\nput 20 * 14 + 2 into finalHeight\nend if\n\nrepeat with i = maxLevelNum+1 to 20\nset textStyle of char 1 of line i of card field \"levels\" to bold\nend repeat\n\nput maxWidth + 12 into finalWidth\n\nset width of button \"boxOverlay1\" to finalWidth + 12\nset height of button \"boxOverlay1\" to finalHeight + 40\nset loc of button \"boxOverlay1\" to 256,171\n\nset width of card field \"levels\" to finalWidth\nset height of card field \"levels\" to finalHeight\nset top of card field \"levels\" to top of button \"boxOverlay1\" + 6\nset left of card field \"levels\" to left of button \"boxOverlay1\" + 6\n\nset rect of button \"levelSelectionButton\" to rect of card field \"levels\"\nset width of button \"levelSelection\" to width of card field \"levels\" - 2\n\nset bottomRight of button \"Go!\" to ¬\nright of button \"boxOverlay1\" - 6, bottom of button \"boxOverlay1\" - 6\n\nset bottomRight of button \"Cancel\" to ¬\nleft of button \"Go!\" - 8, bottom of button \"boxOverlay1\" - 6\n\nset width of card field \"speedrunMode\" to ¬\nleft of button \"cancel\" - left of button \"boxOverlay1\"\nset loc of card field \"speedrunMode\" to loc of button \"cancel\"\nset left of card field \"speedrunMode\" to left of button \"boxOverlay1\"\n\nset rect of button \"boxOverlay2\" to ¬\nleft of button \"boxOverlay1\" - 4, ¬\ntop of button \"boxOverlay1\" - 4, ¬\nright of button \"boxOverlay1\" + 4, ¬\nbottom of button \"boxOverlay1\" + 4\n\nset rect of button \"boxOverlay3\" to ¬\nleft of button \"boxOverlay2\" - 1, ¬\ntop of button \"boxOverlay2\" - 1, ¬\nright of button \"boxOverlay2\" + 1, ¬\nbottom of button \"boxOverlay2\" + 1\n\nsetVisibleOfLevelSelectionStuffWithoutLockingScreen true\nunlock screen --with visual effect zoom open fast\nend mouseUp",
