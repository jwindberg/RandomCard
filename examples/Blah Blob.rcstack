        {
          "id": 50,
          "kind": "Button",
          "name": "clean fields",
          "rect": {
            "left": 387,
            "top": 180,
            "right": 494,
            "bottom": 210
          },
          "script": "on mouseUp\nrepeat with i = 1 to the number of card fields\ncleanField i\nend repeat\nend mouseUp\n\non cleanField fieldNum\nput the number of lines of card field fieldNum into lineCount\n\nrepeat with i = 1 to lineCount\nput lineCount - i + 1 into theLine\nif line theLine of card field fieldNum is empty then\ndelete line theLine of card field fieldNum\nend if\nend repeat\n\nrepeat while last char of card field fieldNum = return\ndelete last char of card field fieldNum\nend repeat\nend cleanField",
          "visible": true,
          "style": "Rectangle",
          "text_font": "Chicago",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
