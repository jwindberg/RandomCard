        {
          "id": 49,
          "kind": "Button",
          "name": "play2",
          "rect": {
            "left": 465,
            "top": 12,
            "right": 512,
            "bottom": 24
          },
          "script": "\non startDeath\nglobal deathPieceCount, dead, resetAfterDead, deathStartTime, willDie\nglobal deathCount, deathCycles, currentLevelDeathCount\n\nput 0 into deathCycles\nadd 1 to deathCount\nadd 1 to currentLevelDeathCount\ndisplayDeaths\n\nput false into willDie\nput true into resetAfterDead\nput true into dead\n\nlock screen\nhide button \"player\"\nhide button \"eyes\"\n\nput item 1 of loc of button \"player\" into px\nput item 2 of loc of button \"player\" into py\n\nset topLeft of button \"boom1\" to ((px - 32) & \",\" & (py - 32))\nset topLeft of button \"boom2\" to (px & \",\" & (py - 32))\nset topLeft of button \"boom3\" to ((px - 32) & \",\" & py)\nset topLeft of button \"boom4\" to (px & \",\" & py)\nset topLeft of button \"argh\" to ((px - 32) & \",\" & (py - 32))\nshow button \"boom1\"\nshow button \"boom2\"\nshow button \"boom3\"\nshow button \"boom4\"\nshow button \"argh\"\n\nset icon of button \"player\" to \"boom\"\n\nput -67 into startAngle\nput 227 into endAngle\n\nput ((endAngle-startAngle) div (deathPieceCount-1)) into da\n\nplayDeathFX\n\nput the ticks into deathStartTime\ntimingReset\n\nput round(deathPieceCount / 3) into p1\nput round(deathPieceCount / 2) + 1 into p2\nput round(deathPieceCount / 3 * 2) + 2 into p3\n\nput random(p2 - p1) + p1 into eyeball1\nput random(p3 - p2) + p2 into eyeball2\n\nrepeat with i = 1 to deathPieceCount\nput \"piece\" & i into pieceName\nhide button pieceName\nset loc of button pieceName to loc of button \"player\"\n\nput startAngle + da * (i-1) into baseAngle\nput baseAngle + random(da div 2) - da/4 into a\nput random(4) + 9 into speed\nput round(realCos(a) * speed) into dx\nput round(-realSin(a) * speed) - 3 into dy\nput dx & return & dy & return & (i = eyeball1 or i = eyeball2) ¬\ninto button pieceName\n\nif line 3 of button pieceName then\nset icon of button pieceName to 7000 + ((i - 1) mod 4)\nelse\nset icon of button pieceName to 5000 + ((i - 1) mod 5)\nend if\n\nshow button pieceName\nend repeat\nunlock screen\nend startDeath\n\non deathCycle\nglobal deathPieceCount, dead, deathStartTime, deathCycles\nput the ticks into currentTime\n\nif visible of button \"argh\" and currentTime - deathStartTime > 35 then\nhide button \"boom1\"\nhide button \"boom2\"\nhide button \"boom3\"\nhide button \"boom4\"\nhide button \"argh\"\nend if\n\nrepeat with i = 1 to deathPieceCount\nput \"piece\" & i into pieceName\n\nif line 3 of button pieceName then\nset icon of button pieceName to ¬\n(((icon of button pieceName) - 7000 + 1) mod 4) + 7000\nelse\nset icon of button pieceName to ¬\n(((icon of button pieceName) - 5000 + 1) mod 5) + 5000\nend if\n\nadd 1 to line 2 of button pieceName\nset topLeft of button pieceName to ¬\n(left of button pieceName + line 1 of button pieceName), ¬\n(top of button pieceName + line 2 of button pieceName)\nend repeat\n\nsend \"handleChangingDoors\" to button \"play3\"\nsend \"handleAnimatingTiles\" to button \"play3\"\nupdateMapDisplay\nadd 1 to deathCycles\n\nif deathCycles > 30 then\nput false into dead\nend if\nend deathCycle\n\non doWin\nglobal winPos\n\nput 6 into travelFrameCount\nput 30 into slurpFrameCount\nput travelFrameCount + slurpFrameCount into totalAnimationFrameCount\n--hide button \"eyes\"\n\nput 16 into eyeTravelFrameCount\nput 8 into eyeSlurpAStart\nput 10 into eyeSlurpAFrameCount\nput 4 into eyeSlurpBFrameCount\nput 0 into eyeOffsetX\nput 11 into eyeOffsetY\n\nput topLeft of button \"player\" into startPos\nput posAtTilePos(item 1 of winPos, item 2 of winPos) into p\nput globalPosAtPos(item 1 of p, item 2 of p) into endPos\n\nput 10 into confettiCount\nput empty into confettiData\n\nput item 1 of endPos + 16 & \",\" & item 2 of endPos + 30 into confettiStartPos\n\nplaySlurpFX\n\nrepeat with i = 1 to confettiCount\nput \"piece\" & i into pieceName\nset topLeft of button pieceName to confettiStartPos\nset icon of button pieceName to \"confetti\" & (((i - 1) mod 8) + 1)\nhide button pieceName\n\nput lerp((i-1) / (confettiCount-1), 45, 135) into angle\nadd (random(10) - 5) to angle\nput realCos(angle) * 12 into dx\nput -realSin(angle) * (random(10)/5+7) into dy\nput item 1 of confettiStartPos && item 2 of confettiStartPos ¬\n&& dx && dy && 1 && 0 && return after confettiData\nend repeat\n\nput false into done\n\nrepeat with frame = 1 to 300\ntimingStartFrame\nlock screen\n\nif frame ≤ totalAnimationFrameCount then\nif frame ≤ travelFrameCount then\nput (frame - 1) / (travelFrameCount-1) into u\nput lerp(u, item 1 of startPos, item 1 of endPos) & \",\" & ¬\nlerp(u, item 2 of startPos, item 2 of endPos) into newPos\nset topLeft of button \"player\" to newPos\npositionEyes \"0,0\"\nelse\nset icon of button \"player\" to \"win\" & ((frame-travelFrameCount+1) div 2)\n\nput (frame - travelFrameCount - 1) into eyeTravelFrame\n\nif eyeTravelFrame ≤ eyeTravelFrameCount then\nput eyeTravelFrame / (eyeTravelFrameCount-1) into u\n\nput lerp(u, item 1 of endPos, item 1 of endPos) & \",\" & ¬\nlerp(u, item 2 of endPos + eyeOffsetX, item 2 of endPos + eyeOffsetY) into newPos\nset topLeft of button \"eyes\" to newPos\nend if\nend if\n\n\nput (frame - eyeSlurpAStart) into eyeSlurpAFrame\nput (frame - totalAnimationFrameCount + eyeSlurpBFrameCount) into eyeSlurpBFrame\n\nif eyeSlurpAFrame ≥ 1 and eyeSlurpAFrame ≤ eyeSlurpAFrameCount then\nset icon of button \"eyes\" to \"eyeWinA\" & ((eyeSlurpAFrame+1) div 2)\nelse if eyeSlurpBFrame ≥ 1 and eyeSlurpBFrame ≤ eyeSlurpBFrameCount then\nif eyeSlurpBFrame = 1 then\nplayPopFX\nend if\n\nset icon of button \"eyes\" to \"eyeWinB\" & eyeSlurpBFrame\nelse if frame < eyeSlurpAStart then\nif icon of button \"eyes\" > 3000 then\nset icon of button \"eyes\" to (icon of button \"eyes\" - 1)\nend if\nend if\n\nelse if frame ≥ totalAnimationFrameCount + 10 then\nif frame = totalAnimationFrameCount + 10 then\nput the ticks into confettiStartTime\nplayYay\nend if\n\nrepeat with i = 1 to confettiCount\nput \"piece\" & i into pieceName\nshow button pieceName\n\nput line i of confettiData into data\nput word 3 of data into dx\nput word 4 of data into dy\n\nif abs(dx) > 0.1 then\nput (dx * 0.9) into dx\nelse\nadd ((random(11) - 6) / 3) to dx\nend if\n\nif dy < 2 then\nadd 0.5 to dy\nend if\n\nadd dx to word 1 of data\nadd dy to word 2 of data\nput dx into word 3 of data\nput dy into word 4 of data\n\nset loc of button pieceName to (round(word 1 of data) & \",\" & round(word 2 of data))\n\nif word 6 of data > 3 then\n-- maybe change direction:\nput 0 into word 6 of data\n\nput random(2) into choice\n\nif choice = 1 then\nput (1 - word 5 of data) into word 5 of data\nput 0 into word 6 of data\nend if\nelse\nadd 1 to word 6 of data\nend if\n\nif word 5 of data = 1 then\nif icon of button pieceName > 5005 then\nset icon of button pieceName to icon of button pieceName-1\nelse\nset icon of button pieceName to 5012\nend if\nelse\nif icon of button pieceName < 5012 then\nset icon of button pieceName to icon of button pieceName+1\nelse\nset icon of button pieceName to 5005\nend if\nend if\n\nput data into line i of confettiData\nend repeat\n\nif the ticks - confettiStartTime ≥ 210 then\nput true into done\nend if\nend if\n\nsend \"handleChangingDoors\" to button \"play3\"\nsend \"handleAnimatingTiles\" to button \"play3\"\nupdateMapDisplay\nunlock screen\ntimingEndFrameAndMaybeFrameLimit\n\nput the ticks into currentTime\nif done then exit repeat\nend repeat\nend doWin",
          "visible": false,
          "style": "Transparent",
          "text_font": "Geneva",
          "text_size": 9,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
