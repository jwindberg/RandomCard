        {
          "id": 55,
          "kind": "Button",
          "name": "Reset for Mini vMac distribution!",
          "rect": {
            "left": 387,
            "top": 252,
            "right": 512,
            "bottom": 276
          },
          "script": "on mouseUp\nanswer \"Are you sure you want to reset everything?\" with \"Yes\" or \"No\"\nif it is not \"yes\" then exit mouseUp\n\nselect line 2 of button \"frame limit\" of card \"settings\"\nresetGame\nend mouseUp\n\non resetGame\nglobal resetGameForDistribution\n-- Compacting the stack while music is playing crashes the system!!\nstopMusic\n\nif \"startAtLevel 1,\" is not in script of button \"Play Game!\" of card \"title\" then\nanswer \"You left the start game button in a messed up state you fool!\"\nexit resetGame\nend if\n\nrepeat with i = 1 to the number of card fields\nput empty into card field i\nend repeat\n\nset hilite of button \"speedrun mode\" of card \"settings\" to false\nset hilite of button \"show frames per second\" of card \"settings\" to false\nset hilite of button \"Sound FX\" of card \"settings\" to true\nset hilite of button \"Music\" of card \"settings\" to true\nput \"left,right,space,delete,escape,,r\" into card field \"controls\" of card \"game\"\nset name of button 1 of card \"settings\" to \"Left\"\nset name of button 2 of card \"settings\" to \"Right\"\nset name of button 3 of card \"settings\" to \"Space\"\nset name of button 4 of card \"settings\" to \"Backspace\"\nset name of button 5 of card \"settings\" to \"Escape\"\nset name of button 7 of card \"settings\" to \"(Unset)\"\nset name of button 6 of card \"settings\" to \"R\"\nset enabled of button 6 of card \"settings\" to false\nset enabled of button \"Reset speedrun:\" of card \"settings\" to false\nhide card field \"sound warning\" of card \"settings\"\nsend \"updateControls\" to card \"instructions\"\nset hilite of button \"testing\" of card \"settings\" to false\nset hilite of button \"debug move\" of card \"settings\" to false\nhide button \"testing\" of card \"settings\"\nhide button \"debug move\" of card \"settings\"\n\nhide button \"dialogs\" of card \"game\"\nhide button \"play\" of card \"game\"\nhide button \"play2\" of card \"game\"\nhide button \"play3\" of card \"game\"\nhide button \"show\" of card \"game\"\nhide button \"Frame rate:\" of card \"game\"\nhide button id 113 of card \"game\"\nhide button \"tileHandlers\" of card \"game\"\nhide card field \"debug\" of card \"game\"\nhide card field \"startLevel\" of card \"game\"\nhide card field \"currentLevel\" of card \"game\"\nhide card field \"controls\" of card \"game\"\nhide card field \"maxLevelPlayed\" of card \"game\"\nset name of button id 142 of card \"game\" to \"\"\nput empty into card field \"level name\" of card \"game\"\nput empty into card field \"mapDisplay\" of card \"game\"\nput empty into card field \"debug\" of card \"game\"\nput empty into card field \"currentLevel\" of card \"game\"\nput empty into card field \"startLevel\" of card \"game\"\nput empty into card field \"highscoreNameField\" of card \"game\"\nput empty into card field \"highscoreSpeedrunTime\" of card \"game\"\nput empty into card field \"highscoreSpeedrunRank\" of card \"game\"\nput empty into card field \"highscoreSpeedrunBestTime\" of card \"game\"\nput empty into card field \"highscoreGameEndText\" of card \"game\"\nput \"1\" into card field \"maxLevelPlayed\" of card \"game\"\nsend \"hideHighScoresDialog\" to button \"dialogs\" of card \"game\"\nsend \"hidePauseDialog\" to button \"dialogs\" of card \"game\"\nsend \"hideSillyWinDialog\" to button \"dialogs\" of card \"game\"\n\nset hilite of button \"Deaths\" of card \"high scores\" to true\nhide button \"deathsOrder\" of card \"high scores\"\nhide button \"discoveredDeathsAsc\" of card \"high scores\"\nput false into button \"discoveredDeathsAsc\" of card \"high scores\"\nput empty into card field \"deaths_names\" of card \"high scores\"\nput empty into card field \"deaths_deaths\" of card \"high scores\"\nput empty into card field \"deaths_wins\" of card \"high scores\"\nput empty into card field \"deaths_names\" of card \"high scores\"\nput empty into card field \"deaths_startedAt\" of card \"high scores\"\nput empty into card field \"deaths_stoppedAt\" of card \"high scores\"\nput empty into card field \"speedrun_names\" of card \"high scores\"\nput empty into card field \"speedrun_times\" of card \"high scores\"\nput empty into card field \"speedrun_deaths\" of card \"high scores\"\nput empty into card field \"speedrun_wins\" of card \"high scores\"\nshow card field \"deaths_names\" of card \"high scores\"\nshow card field \"deaths_deaths\" of card \"high scores\"\nshow card field \"deaths_wins\" of card \"high scores\"\nshow card field \"deaths_names\" of card \"high scores\"\nshow card field \"deaths_startedAt\" of card \"high scores\"\nshow card field \"deaths_stoppedAt\" of card \"high scores\"\nhide card field \"speedrun_names\" of card \"high scores\"\nhide card field \"speedrun_times\" of card \"high scores\"\nhide card field \"speedrun_deaths\" of card \"high scores\"\nhide card field \"speedrun_wins\" of card \"high scores\"\nset enabled of button \"back\" of card \"high scores\" to false\nset enabled of button \"forward\" of card \"high scores\" to false\nselect line 1 of button \"selectedLevel\" of card \"high scores\"\n\nanswer \"Protect stack?\" with \"No\" or \"Yes\"\n\nput true into resetGameForDistribution\n\nif it is yes then\nset cantDelete of this stack to true\nset cantPeek of this stack to true\nset cantAbort of this stack to true\n\ndoMenu \"Compact Stack\"\n\nanswer \"It is done. Now set the stack user level. \" ¬\n& return & return & \"NB: Quitting the game will not save data!\"\n\ndoMenu \"Protect Stack...\"\nelse\n\nanswer \"It is done.\" ¬\n& return & return & \"NB: Quitting the game will not save data!\"\nend if\n\nend resetGame\n",
          "visible": true,
          "style": "Rectangle",
          "text_font": "Geneva",
          "text_size": 9,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
