          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "MusicBox XCMD 3.0 by Alex Metcalf\nPlayMOD XFCN 2.0 by Kevin Harris\nQuitTheFinder by Jonathan Abourbih\nShutdown XCMD by Peter Pawlowski\nStrWidth and FindFolder by Frédéric Rinaldi\nFileExists by Guy Kuo\n\n",
          "hilite": false,
          "auto_hilite": false,
          "show_name": false,
