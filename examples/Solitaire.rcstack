    {
      "id": 96,
      "name": "About",
      "script": "",
      "background": 2,
      "picture": {
        "width": 800,
        "height": 600,
        "data": ""
      },
      "show_pict": true,
      "parts": [
        {
          "id": 97,
          "kind": "Field",
          "name": "Title",
          "rect": {
            "left": 40,
            "top": 30,
            "right": 760,
            "bottom": 70
          },
          "script": "",
          "style": "Transparent",
          "contents": "About Solitaire",
          "text_size": 28,
          "text_style": "bold",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 98,
          "kind": "Field",
          "name": "Credits",
          "rect": {
            "left": 40,
            "top": 80,
            "right": 760,
            "bottom": 200
          },
          "script": "",
          "style": "Transparent",
          "contents": "The cards are Byron Knoll's Vector Playing Cards (version 1.3), which he released into the public domain.\n\nFreeCell's numbered deals follow the ones Jim Horne wrote for Windows FreeCell, so game 1 here is the same deal as game 1 there.",
          "text_size": 13,
          "text_style": "plain",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 99,
          "kind": "Field",
          "name": "Shows Label",
          "rect": {
            "left": 40,
            "top": 214,
            "right": 760,
            "bottom": 236
          },
          "script": "",
          "style": "Transparent",
          "contents": "What Solitaire shows about RandomCard",
          "text_size": 15,
          "text_style": "bold",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 100,
          "kind": "Field",
          "name": "Shows",
          "rect": {
            "left": 40,
            "top": 240,
            "right": 760,
            "bottom": 470
          },
          "script": "",
          "style": "Scrolling",
          "contents": "Each card is a button whose icon is the card's face: icons of any size, in color.\nDragging is HyperTalk: repeat while the mouse is down, moving the cards to the mouseLoc, and setting their partNumber to bring them to the front.\nThe game's rules are the card's own script, in plain HyperTalk: choose Objects ▸ Card Script on the FreeCell card to read them. Its shuffle is Windows FreeCell's, with the same arithmetic.\nA game in progress is kept in hidden fields, so it's saved with the stack, and Undo goes back to the start of the deal.",
          "text_size": 13,
          "text_style": "plain",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 101,
          "kind": "Button",
          "name": "Games",
          "rect": {
            "left": 40,
            "top": 540,
            "right": 160,
            "bottom": 570
          },
          "script": "on mouseUp\n  go to card \"Games\"\nend mouseUp",
          "style": "RoundRect"
        }
      ]
    }
  ],
