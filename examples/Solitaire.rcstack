          "kind": "Field",
          "name": "Rules",
          "rect": {
            "left": 0,
            "top": 0,
            "right": 8,
            "bottom": 8
          },
          "script": "",
          "style": "Transparent",
          "contents": "Get all 52 cards onto the four foundations at the top right, each suit from ace up to king. Columns build down in alternating colors, and only a king can go in an empty column; turning a card over is automatic. Click the stock at the top left to deal a card (or three, with Draw Three) onto the waste; when it runs out, click again to turn the waste over. You can move a face-up card with the cards on it.",
          "text_size": 10,
          "text_style": "plain",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false,
          "visible": false
        },
