        {
          "id": 213,
          "kind": "Field",
          "name": "Rules",
          "rect": {
            "left": 0,
            "top": 0,
            "right": 8,
            "bottom": 8
          },
          "script": "",
          "style": "Transparent",
          "contents": "Build eight runs from king down to ace, each of one suit; a finished run comes off the table on its own. Any card can go on a card one rank higher, whatever its suit, but only a run of one suit moves together. Any card or run can go in an empty column. Click the stock at the bottom right to deal a card onto every column, which all need a card first. Choose one, two or four suits for new games.",
          "text_size": 10,
          "text_style": "plain",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false,
          "visible": false
        },
