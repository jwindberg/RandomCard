    {
      "id": 331,
      "name": "About",
      "script": "",
      "background": 2,
      "picture": {
        "width": 672,
        "height": 480,
        "data": ""
      },
      "show_pict": true,
      "parts": [
        {
          "id": 332,
          "kind": "Field",
          "name": "Title",
          "rect": {
            "left": 32,
            "top": 24,
            "right": 640,
            "bottom": 56
          },
          "script": "",
          "style": "Transparent",
          "contents": "About Solitaire",
          "text_size": 22,
          "text_style": "bold",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 333,
          "kind": "Field",
          "name": "Credits",
          "rect": {
            "left": 32,
            "top": 64,
            "right": 640,
            "bottom": 176
          },
          "script": "",
          "style": "Transparent",
          "contents": "The card faces are Byron Knoll's Vector Playing Cards (version 1.3), which he released into the public domain. The back follows Bas de Reuver's (BdRGames) design 1, CC0.\n\nFreeCell's numbered deals follow the ones Jim Horne wrote for Windows FreeCell, so game 1 here is the same deal as game 1 there. Klondike and Spider shuffle the same way, so their game numbers deal the same each time too.",
          "text_size": 10,
          "text_style": "plain",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 334,
          "kind": "Field",
          "name": "Shows Label",
          "rect": {
            "left": 32,
            "top": 187,
            "right": 640,
            "bottom": 205
          },
          "script": "",
          "style": "Transparent",
          "contents": "What Solitaire shows about RandomCard",
          "text_size": 12,
          "text_style": "bold",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 335,
          "kind": "Field",
          "name": "Shows",
          "rect": {
            "left": 32,
            "top": 208,
            "right": 640,
            "bottom": 400
          },
          "script": "",
          "style": "Scrolling",
          "contents": "Each card is a button whose icon is the card's face, or its back: icons of any size, in color, changed by the script as cards turn over.\nDragging is HyperTalk: repeat while the mouse is down, moving the cards to the mouseLoc, and setting their partNumber to bring them to the front.\nEach game's rules are its card's own script, in plain HyperTalk, and what the games share (the shuffle, the record, the win) is in the stack script: choose Objects ▸ Card Script or Stack Script to read them.\nA game in progress is kept in hidden fields, so it's saved with the stack, and Undo goes back to the start of the deal.",
          "text_size": 10,
          "text_style": "plain",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 336,
          "kind": "Button",
          "name": "Games",
          "rect": {
            "left": 32,
            "top": 432,
            "right": 128,
            "bottom": 456
          },
          "script": "on mouseUp\n  go to card \"Games\"\nend mouseUp",
          "style": "RoundRect"
        }
      ]
    }
  ],
