    {
      "id": 172,
      "name": "Settings",
      "script": "-- The server's address is the user's, kept on their computer: the box shows\n-- it, and changing it sets it.\non openCard\n  put setting \"Address\" of connection \"VideoDB\" into card field \"Server\"\n  pass openCard\nend openCard",
      "background": 1,
      "picture": {
        "width": 640,
        "height": 480,
        "data": ""
      },
      "show_pict": true,
      "parts": [
        {
          "id": 173,
          "kind": "Field",
          "name": "Heading",
          "rect": {
            "left": 20,
            "top": 14,
            "right": 400,
            "bottom": 46
          },
          "script": "",
          "style": "Transparent",
          "contents": "Settings",
          "text_size": 24,
          "text_style": "bold",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 174,
          "kind": "Field",
          "name": "Server label",
          "rect": {
            "left": 20,
            "top": 60,
            "right": 110,
            "bottom": 80
          },
          "script": "",
          "style": "Transparent",
          "contents": "Server",
          "text_size": 13,
          "text_style": "bold",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        },
        {
          "id": 175,
          "kind": "Field",
          "name": "Server",
          "rect": {
            "left": 110,
            "top": 56,
            "right": 450,
            "bottom": 82
          },
          "script": "on closeField\n  set setting \"Address\" of connection \"VideoDB\" to me\n  put setting \"Address\" of connection \"VideoDB\" into me\nend closeField",
          "style": "Rectangle",
          "contents": "",
          "text_size": 13,
          "text_style": "plain",
          "text_align": "Left",
          "lock_text": false,
          "dont_wrap": true,
          "dont_save": true
        },
        {
          "id": 176,
          "kind": "Button",
          "name": "Test",
          "rect": {
            "left": 460,
            "top": 56,
            "right": 620,
            "bottom": 82
          },
          "script": "on mouseUp\n  get graphQL(\"query { movies(page: 0, size: 1) { totalElements } }\")\n  if word 1 of it is \"Error:\" then answer it\n  else answer \"videodb answered: it has\" && key \"totalElements\" of key \"movies\" of json it && \"movies.\"\nend mouseUp",
          "style": "RoundRect"
        },
        {
          "id": 177,
          "kind": "Button",
          "name": "Connections…",
          "rect": {
            "left": 460,
            "top": 90,
            "right": 620,
            "bottom": 116
          },
          "script": "on mouseUp\n  doMenu \"Connections…\"\nend mouseUp",
          "style": "RoundRect"
        },
        {
          "id": 178,
          "kind": "Field",
          "name": "About",
          "rect": {
            "left": 20,
            "top": 130,
            "right": 620,
            "bottom": 430
          },
          "script": "",
          "style": "Transparent",
          "contents": "VideoDB is the front end of videodb, a movie library: a Kotlin service with a GraphQL API, and a React front end on the web. This stack does what the web pages do, from HyperTalk: a GraphQL request is JSON posted to /graphql (the graphQL function in the stack script), and the answer is read with key … of json.\n\nMovies: a page of 24 at a time, searched, or by first letter. Click a movie for its details.\nMovie: its details, and the movies before and after it (the arrow keys go there too).\nEdit: every field, saved with the updateMovie mutation; OMDb Lookup fills the form from OMDb.\n\nPosters: the page as a grid of posters, each an image whose source is the poster's address; it loads in the background. Play plays the movie from the server, in a movie window.\n\nThe server is videodb's web front end, which passes /graphql, /omdb and /videos on to the service. Its address is yours, not the stack's: the stack's VideoDB connection, kept on this computer: File > Connections… sets it up.",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Left",
          "lock_text": true,
          "dont_wrap": false
        }
      ]
    }
  ]
}