        {
          "id": 108,
          "kind": "Button",
          "name": "Send",
          "rect": {
            "left": 548,
            "top": 38,
            "right": 620,
            "bottom": 62
          },
          "script": "on mouseUp\n  -- Make the request on this card, and show the reply.\n  put field \"URL\" into theURL\n  if theURL is empty then\n    answer \"Type a URL first.\"\n    exit mouseUp\n  end if\n  -- Params: one name=value a line. A name may repeat (color=red, then\n  -- color=blue), and is sent repeated: ?color=red&color=blue.\n  put empty into query\n  repeat with i = 1 to the number of lines of field \"Params\"\n    get line i of field \"Params\"\n    if it is empty then next repeat\n    put offset(\"=\", it) into eq\n    if eq is 0 then\n      put urlEncode(it) into pair\n    else\n      put urlEncode(char 1 to eq - 1 of it) & \"=\" & urlEncode(char eq + 1 to length(it) of it) into pair\n    end if\n    if query is empty then put pair into query\n    else put \"&\" & pair after query\n  end repeat\n  if query is not empty then\n    if \"?\" is in theURL then put \"&\" & query after theURL\n    else put \"?\" & query after theURL\n  end if\n  -- Headers: one Name: value a line.\n  set the httpHeaders to field \"Headers\"\n  put field \"Method\" into m\n  if m is empty then put \"GET\" into m\n  put \"Sending…\" into field \"Status\"\n  if field \"Body\" is empty then request m to url theURL\n  else request m with field \"Body\" to url theURL\n  put it into reply\n  -- The status even when it worked; the result says why when no reply came.\n  if the responseStatus is empty then put the result into field \"Status\"\n  else put the responseStatus into field \"Status\"\n  put the responseTime && \"ms\" into field \"Time\"\n  put the length of reply && \"chars\" into field \"Size\"\n  if the hilite of button \"Pretty\" then put the pretty of json reply into field \"Reply\"\n  else put reply into field \"Reply\"\n  put the responseHeaders into field \"Reply Headers\"\n  put m && theURL into field \"Sent\"\nend mouseUp\n",
          "visible": true,
          "style": "Default",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
