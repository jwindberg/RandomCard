        {
          "id": 103,
          "kind": "Button",
          "name": "New Request",
          "rect": {
            "left": 412,
            "top": 8,
            "right": 512,
            "bottom": 30
          },
          "script": "on mouseUp\n  ask \"Name the new request:\" with \"New request\"\n  if it is empty then exit mouseUp\n  put it into newName\n  doMenu \"New Card\"\n  put newName into field \"Name\"\n  set the name of this card to newName\n  put \"GET\" into field \"Method\"\n  select text of field \"URL\"\nend mouseUp\n",
          "visible": true,
          "style": "RoundRect",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
