        {
          "id": 104,
          "kind": "Button",
          "name": "Delete Request",
          "rect": {
            "left": 520,
            "top": 8,
            "right": 620,
            "bottom": 30
          },
          "script": "on mouseUp\n  if the number of cards is 1 then\n    answer \"This is the only request; type over it instead.\"\n    exit mouseUp\n  end if\n  answer \"Delete the request\" && quote & field \"Name\" & quote & \"?\" with \"Delete\" or \"Cancel\"\n  if it is \"Delete\" then doMenu \"Delete Card\"\nend mouseUp\n",
          "visible": true,
          "style": "RoundRect",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
          "auto_hilite": true,
