          "scroll": 0
        },
        {
          "id": 123,
          "kind": "Field",
          "name": "Shows Label",
          "rect": {
            "left": 20,
            "top": 164,
            "right": 620,
            "bottom": 184
          },
          "script": "",
          "visible": true,
          "style": "Transparent",
          "text_font": "Geneva",
          "text_size": 13,
          "text_style": "bold",
          "text_align": "Left",
          "contents": "What Swatches shows about RandomCard",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": true,
          "dont_wrap": false,
          "auto_tab": false,
          "wide_margins": false,
          "show_lines": false,
          "shared_text": false,
          "dont_search": false,
          "auto_select": false,
          "multiple_lines": false,
          "text_height": 0,
          "fixed_line_height": false,
          "scroll": 0
        },
        {
          "id": 124,
          "kind": "Field",
          "name": "Shows",
          "rect": {
            "left": 20,
            "top": 186,
            "right": 620,
            "bottom": 436
          },
          "script": "",
          "visible": true,
          "style": "Scrolling",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "Convert: a web service called from HyperTalk (load url … with message, so the card never waits), JSON read with key … of json, a combo box (the ▼ of examples), Don't Save fields for results, and Copy Text to the system clipboard.\nMixing Light: sliders, each with its own track color, sending sliderMoved and sliderChanged.\nColor Wheel: a picture painted by the stack's own script, stroke by stroke in color with the line tool, a slider for value, and a marker that follows the mouse.\nHarmony: several requests at once, each answer matched to its swatch, and JSON arrays (element i of json) from the API's schemes.\nContrast: colored text and fills set from a script (foreColor and backColor), and WCAG 2's formulas in plain HyperTalk.\nEverywhere: buttons and fields in color, and functions in the stack script that every card shares.",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": true,
          "dont_wrap": false,
          "auto_tab": false,
          "wide_margins": false,
          "show_lines": false,
          "shared_text": false,
          "dont_search": false,
          "auto_select": false,
          "multiple_lines": false,
          "text_height": 0,
          "fixed_line_height": false,
          "scroll": 0
        }
      ],
