        },
        {
          "id": 70,
          "kind": "Field",
          "name": "Why",
          "rect": {
            "left": 20,
            "top": 294,
            "right": 620,
            "bottom": 436
          },
          "script": "",
          "visible": true,
          "style": "Transparent",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "Why do red and green make yellow? Your eye has three kinds of color receptors, most sensitive to long (reddish), medium (greenish) and short (bluish) light. Red and green light together stir the first two just as yellow light does, so you see yellow: three lights are enough to fool the eye, which is why screens use them.\n\nLight adds up: all three at full is white, and none is black. Equal amounts make a gray. Paint and ink work the other way, taking light away, which is why printers use cyan, magenta, yellow and black (CMYK) instead.",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": true,
          "dont_wrap": false,
          "auto_tab": false,
          "wide_margins": false,
          "show_lines": false,
          "shared_text": false,
          "dont_search": false,
          "auto_select": false,
          "multiple_lines": false,
          "text_height": 0,
          "fixed_line_height": false,
          "scroll": 0
        }
