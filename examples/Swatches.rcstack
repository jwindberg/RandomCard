          },
          "script": "",
          "visible": true,
          "style": "Transparent",
          "text_font": "Geneva",
          "text_size": 24,
          "text_style": "bold",
          "text_align": "Left",
          "contents": "Contrast",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": true,
          "dont_wrap": false,
          "auto_tab": false,
          "wide_margins": false,
          "show_lines": false,
          "shared_text": false,
          "dont_search": false,
          "auto_select": false,
          "multiple_lines": false,
          "text_height": 0,
          "fixed_line_height": false,
          "scroll": 0
        },
        {
          "id": 104,
          "kind": "Field",
          "name": "About",
          "rect": {
            "left": 20,
            "top": 50,
            "right": 620,
            "bottom": 84
          },
          "script": "",
          "visible": true,
          "style": "Transparent",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "Text has to stand out from what's behind it. WCAG 2, the W3C's accessibility guidelines, measure contrast as a ratio, from 1:1 (none) to 21:1 (black on white).",
