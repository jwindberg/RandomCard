        {
          "id": 122,
          "kind": "Button",
          "name": "Test Connection",
          "rect": {
            "left": 460,
            "top": 124,
            "right": 620,
            "bottom": 150
          },
          "script": "on mouseUp\n  put url apiURL(\"/id?hex=0047AB\") into reply\n  if the result is not empty then\n    answer \"No answer from The Color API:\" && the result\n  else\n    answer \"The Color API answered: #0047AB is\" && key \"value\" of key \"name\" of json reply & \".\"\n  end if\nend mouseUp",
          "visible": true,
          "style": "RoundRect",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Center",
          "contents": "",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": false,
          "dont_wrap": false,
          "auto_tab": false,
          "wide_margins": false,
          "show_lines": false,
