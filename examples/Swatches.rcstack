          "scroll": 0
        },
        {
          "id": 119,
          "kind": "Field",
          "name": "Credits",
          "rect": {
            "left": 20,
            "top": 52,
            "right": 620,
            "bottom": 120
          },
          "script": "",
          "visible": true,
          "style": "Transparent",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "The names and conversions come from The Color API (www.thecolorapi.com), a free service by Josh Beckman, which needs no key. Swatches asks it only when you look something up. The color math (hex, RGB and HSV, the wheels, WCAG contrast) is in this stack's own script: choose Objects ▸ Stack Script to read it.",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": true,
          "dont_wrap": false,
