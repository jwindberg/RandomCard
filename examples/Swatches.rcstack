        {
          "id": 116,
          "kind": "Field",
          "name": "Why",
          "rect": {
            "left": 20,
            "top": 352,
            "right": 620,
            "bottom": 436
          },
          "script": "",
          "visible": true,
          "style": "Transparent",
          "text_font": "Geneva",
          "text_size": 12,
          "text_style": "plain",
          "text_align": "Left",
          "contents": "The ratio compares the relative luminance of the two colors: how bright each looks, with the eye's greater sensitivity to green counted in. AA is the usual goal and AAA the stricter one. Large text is 18 point, or 14 point bold. The ratio is never rounded up: 4.49 fails a 4.5 minimum.",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": true,
          "dont_wrap": false,
          "auto_tab": false,
