          "text_style": "bold",
          "text_align": "Left",
          "contents": "About Swatches",
          "hilite": false,
          "auto_hilite": true,
          "show_name": true,
          "enabled": true,
          "family": 0,
          "shared_hilite": true,
          "icon": 0,
          "title_width": 0,
          "selected_line": 0,
          "lock_text": true,
          "dont_wrap": false,
          "auto_tab": false,
          "wide_margins": false,
          "show_lines": false,
          "shared_text": false,
          "dont_search": false,
          "auto_select": false,
          "multiple_lines": false,
          "text_height": 0,
